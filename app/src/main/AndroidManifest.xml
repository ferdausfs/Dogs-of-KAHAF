<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions"/>
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <uses-permission android:name="android.permission.REQUEST_DISABLE_APP_HIBERNATION"/>
    <uses-permission android:name="android.permission.BIND_DEVICE_ADMIN"
        tools:ignore="ProtectedPermissions"/>
    <!-- R5 — Private DNS Auto Mode: WRITE_SECURE_SETTINGS is granted ONCE by
         the parent via ADB (see dns_perm_body); until then the feature no-ops
         and shows the guided banner. Exact alarms = precise window boundaries. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions"/>
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32"/>

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false"/>

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
    </queries>

    <application
        android:name=".GuardianApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GuardianShield"
        android:enableOnBackInvokedCallback="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Disable ONLY the default WorkManager initializer so GuardianApp's
             Configuration.Provider (HiltWorkerFactory) is used. Do NOT remove
             the entire InitializationProvider — ProcessLifecycle, Emoji2,
             ProfileInstaller and other App Startup libraries need it. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <activity
            android:name=".ui.dashboard.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Phase 4: Onboarding flow (shown only on first run) -->
        <activity
            android:name=".ui.onboarding.OnboardingActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.GuardianShield"/>

        <!-- Phase 1: Activity Log -->
        <activity
            android:name=".ui.activitylog.ActivityLogActivity"
            android:exported="false"
            android:parentActivityName=".ui.dashboard.MainActivity"/>

        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:parentActivityName=".ui.dashboard.MainActivity"/>

        <activity
            android:name=".ui.settings.AppListActivity"
            android:exported="false"
            android:parentActivityName=".ui.settings.SettingsActivity"/>

        <activity
            android:name=".ui.settings.KeywordActivity"
            android:exported="false"
            android:parentActivityName=".ui.settings.SettingsActivity"/>

        <activity
            android:name=".ui.settings.ScheduleActivity"
            android:exported="false"
            android:parentActivityName=".ui.settings.SettingsActivity"/>

        <activity
            android:name=".ui.settings.TimeLockActivity"
            android:exported="false"
            android:parentActivityName=".ui.settings.SettingsActivity"/>

        <!-- R4 — Content Filters (Smart category protection) -->
        <activity
            android:name=".ui.settings.FiltersActivity"
            android:exported="false"
            android:parentActivityName=".ui.settings.SettingsActivity"/>

        <!-- R4 — Whitelist -->
        <activity
            android:name=".ui.settings.WhitelistActivity"
            android:exported="false"
            android:parentActivityName=".ui.settings.SettingsActivity"/>

        <!-- R5 — Private DNS Auto Mode schedule -->
        <activity
            android:name=".ui.settings.DnsScheduleActivity"
            android:exported="false"
            android:parentActivityName=".ui.settings.SettingsActivity"/>

        <!-- R5 — DNS schedule window-boundary alarm tick (explicit intents only) -->
        <receiver
            android:name=".service.dns.PrivateDnsReceiver"
            android:exported="false"/>

        <!-- R7.2 — Shizuku bridge: provider discovers the Shizuku server so
             the app can run `pm grant`/`settings put` via Shizuku.newProcess
             with no computer. No UserService needed anymore (v3.7.0's
             hand-rolled binder service was removed — it never bound on real
             devices). -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"/>

        <activity
            android:name=".ui.permissions.PermissionsActivity"
            android:exported="false"
            android:parentActivityName=".ui.settings.SettingsActivity"/>

        <activity
            android:name=".ui.setup.PinSetupActivity"
            android:exported="false"/>

        <activity
            android:name=".ui.setup.PinVerifyActivity"
            android:exported="false"/>

        <!-- PHASE 1c (v3.5.0): deliberately non-trivial PIN recovery -->
        <activity
            android:name=".ui.setup.PinRecoveryActivity"
            android:exported="false"/>

        <activity
            android:name=".ui.unlock.DelayUnlockActivity"
            android:exported="false"
            android:excludeFromRecents="true"/>

        <activity
            android:name=".ui.overlay.BlockOverlayActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""/>

        <activity
            android:name=".ui.guard.AccessibilityPromptActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:showOnLockScreen="true"
            android:turnScreenOn="true"/>

        <!-- Optional: Blocked Content Details (flagged for approval) -->
        <activity
            android:name=".ui.overlay.BlockedDetailActivity"
            android:exported="false"
            android:parentActivityName=".ui.dashboard.MainActivity"/>

        <!-- TASK B: Pending reports (cooling-off queue viewer) -->
        <activity
            android:name=".ui.pending.PendingReportsActivity"
            android:exported="false"
            android:parentActivityName=".ui.settings.SettingsActivity"/>

        <!-- PHASE 4b (v3.5.0): static Help & FAQ -->
        <activity
            android:name=".ui.help.HelpActivity"
            android:exported="false"
            android:parentActivityName=".ui.settings.SettingsActivity"/>

        <!-- TASK 2: Islamic reminder overlay for reel/short addiction -->
        <activity
            android:name=".ui.overlay.ReelReminderActivity"
            android:theme="@style/Theme.GuardianShield.Overlay"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"/>

        <service
            android:name=".service.accessibility.GuardianAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:description="@string/accessibility_service_description"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config"/>
        </service>

        <service
            android:name=".service.blocker.GuardianForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="content_blocker"/>
        </service>

        <!-- PHASE 4c (v3.5.0): opt-in notification shade shield. Only the
             system can bind (BIND_NOTIFICATION_LISTENER_SERVICE); the feature
             additionally requires the in-app toggle (default OFF). -->
        <service
            android:name=".service.shield.NotificationShieldService"
            android:exported="true"
            android:label="@string/notif_shield_service_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService"/>
            </intent-filter>
        </service>

        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
            </intent-filter>
        </receiver>

        <receiver
            android:name=".admin.GuardianDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin"/>
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED"/>
            </intent-filter>
        </receiver>

    </application>
</manifest>