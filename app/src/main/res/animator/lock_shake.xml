<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:ordering="sequentially">
    <objectAnimator android:propertyName="rotation"
        android:valueFrom="0" android:valueTo="-12"
        android:duration="60"/>
    <objectAnimator android:propertyName="rotation"
        android:valueFrom="-12" android:valueTo="12"
        android:duration="60"/>
    <objectAnimator android:propertyName="rotation"
        android:valueFrom="12" android:valueTo="-10"
        android:duration="60"/>
    <objectAnimator android:propertyName="rotation"
        android:valueFrom="-10" android:valueTo="10"
        android:duration="60"/>
    <objectAnimator android:propertyName="rotation"
        android:valueFrom="10" android:valueTo="0"
        android:duration="60"/>
</set>
