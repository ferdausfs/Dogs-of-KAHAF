<?xml version="1.0" encoding="utf-8"?>
<!-- ONE SHIELD — Home. Reference-mock restructure (R2, user-approved Content
     Blocker mock): greeting kicker + big title, SPLIT hero card (state text
     block left, "Blocked today" + sparkline right), colorful quick-action
     TILE row, protection summary with round tile wells, recent activity.
     Bindings preserved EXACTLY (same ids, same view types): statusCard
     shieldGlow imgShield txtStatusTitle txtStatusSubtitle txtProtectionBadge
     btnToggle txtStatTotal txtStatAi txtStatTime txtStatKeyword streakCard
     txtStreakTitle txtWeeklyCompare txtStreakDays cardAppBlocking
     cardKeywords cardWhitelist txtSeeAll recyclerRecent.
     Runtime behavior intact: DashboardFragment swaps the hero background per
     state (bg_hero_accent/warning/error) and sets state text/button colors —
     the XML below only re-arranges and re-styles. -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="never"
    android:background="@color/bg_main"
    tools:context=".ui.dashboard.fragments.DashboardFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <!-- greeting kicker + big title (reference header) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:text="@string/home_greeting"
            android:textColor="@color/on_surface_variant"
            android:textSize="14sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="14dp"
            android:text="@string/home_title"
            android:textAppearance="@style/TextAppearance.GuardianShield.Display"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <!-- SPLIT hero: state text block (left) + blocked-today + sparkline (right) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/statusCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.GuardianShield.Card.Beacon">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <FrameLayout
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/bg_icon_well"
                                android:backgroundTint="@color/badge_neutral_fill">
                                <!-- neutral white glow: reads on every hero state -->
                                <View
                                    android:id="@+id/shieldGlow"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/bg_glow_neutral"
                                    android:alpha="0.35"/>
                                <ImageView
                                    android:id="@+id/imgShield"
                                    android:layout_width="26dp"
                                    android:layout_height="26dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_shield_check"
                                    app:tint="@color/on_primary_container"
                                    android:contentDescription="@null"/>
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:text="@string/hero_protection_label"
                                android:textColor="@color/on_primary_container"
                                android:alpha="0.72"
                                android:textSize="13sp"/>

                            <TextView
                                android:id="@+id/txtStatusTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/status_active"
                                android:textColor="@color/on_primary_container"
                                android:textSize="26sp"
                                android:textStyle="bold"
                                android:letterSpacing="-0.02"
                                android:lineSpacingMultiplier="1.15"/>

                            <TextView
                                android:id="@+id/txtStatusSubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/on_primary_container"
                                android:alpha="0.78"
                                android:textSize="13sp"
                                android:lineSpacingMultiplier="1.35"
                                android:layout_marginTop="4dp"/>

                            <TextView
                                android:id="@+id/txtProtectionBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="● Protection Active"
                                android:textColor="@color/on_primary_container"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:background="@drawable/bg_badge"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="5dp"/>
                        </LinearLayout>

                        <!-- right: blocked-today number + decorative sparkline -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="end"
                            android:layout_marginStart="12dp"
                            android:layout_gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/stat_tile_total"
                                android:textColor="@color/on_primary_container"
                                android:alpha="0.72"
                                android:textSize="11sp"
                                android:maxLines="1"/>

                            <TextView
                                android:id="@+id/txtStatTotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:fontFeatureSettings="tnum"
                                android:textColor="@color/on_primary_container"
                                android:textSize="36sp"
                                android:textStyle="bold"
                                android:letterSpacing="-0.03"/>

                            <!-- R4: REAL hourly sparkline (today's blocks) —
                                 replaces static art. -->
                            <com.guardian.shield.ui.charts.SparklineView
                                android:id="@+id/chartSparkline"
                                android:layout_width="104dp"
                                android:layout_height="40dp"
                                android:layout_marginTop="8dp"
                                android:importantForAccessibility="no"/>
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnToggle"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="18dp"
                        android:text="@string/btn_pause"
                        style="@style/Widget.GuardianShield.Button.Tonal"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:paddingTop="22dp"
            android:paddingBottom="10dp"
            android:text="@string/quick_actions"
            style="@style/TextAppearance.GuardianShield.SectionHeader"/>

        <!-- colorful quick-action TILE row (reference mock vibe) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <LinearLayout
                android:id="@+id/cardAppBlocking"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:minHeight="128dp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginHorizontal="6dp"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_tile"
                android:backgroundTint="@color/tile_blue_bg"
                android:foreground="?attr/selectableItemBackground">
                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/white">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_apps"
                        app:tint="@color/tile_blue_fg"
                        android:importantForAccessibility="no"/>
                </FrameLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/quick_apps_title"
                    android:textColor="@color/on_surface"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/quick_apps_sub"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="11sp"
                    android:gravity="center"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardKeywords"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:minHeight="128dp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginHorizontal="6dp"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_tile"
                android:backgroundTint="@color/tile_purple_bg"
                android:foreground="?attr/selectableItemBackground">
                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/white">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_keyword"
                        app:tint="@color/tile_purple_fg"
                        android:importantForAccessibility="no"/>
                </FrameLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/quick_keywords_title"
                    android:textColor="@color/on_surface"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/quick_keywords_sub"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="11sp"
                    android:gravity="center"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardWhitelist"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:minHeight="128dp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginHorizontal="6dp"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_tile"
                android:backgroundTint="@color/tile_green_bg"
                android:foreground="?attr/selectableItemBackground">
                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/white">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_shield_check"
                        app:tint="@color/tile_green_fg"
                        android:importantForAccessibility="no"/>
                </FrameLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/whitelist"
                    android:textColor="@color/on_surface"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/quick_whitelist_sub"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="11sp"
                    android:gravity="center"/>
            </LinearLayout>
        </LinearLayout>

        <!-- protection summary header + week pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="22dp"
            android:paddingBottom="10dp">
            <TextView
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/protection_summary_title"
                style="@style/TextAppearance.GuardianShield.SectionHeader"
                tools:text="Protection Summary"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge"
                android:text="@string/period_week"
                android:textColor="@color/primary_dim"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"/>
        </LinearLayout>

        <!-- summary: AI detections + screen time (Blocked-today lives in the hero) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/statsSummaryCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:foreground="?attr/selectableItemBackground"
            style="@style/Widget.GuardianShield.Card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="18dp"
                android:paddingHorizontal="8dp">
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="8dp">
                    <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_circle" android:backgroundTint="@color/tile_blue_bg" android:layout_marginBottom="8dp">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_ai_spark" app:tint="@color/tile_blue_fg" android:importantForAccessibility="no"/>
                    </FrameLayout>
                    <TextView android:id="@+id/txtStatAi" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:fontFeatureSettings="tnum" android:textColor="@color/on_surface" android:textSize="26sp" android:textStyle="bold" android:letterSpacing="-0.02"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/stat_tile_ai" android:textColor="@color/on_surface_variant" android:textSize="11.5sp" android:gravity="center" android:layout_marginTop="4dp"/>
                </LinearLayout>
                <View android:layout_width="1dp" android:layout_height="48dp" android:layout_gravity="center_vertical" android:background="@color/border_subtle"/>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="8dp">
                    <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_circle" android:backgroundTint="@color/tile_orange_bg" android:layout_marginBottom="8dp">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_clock" app:tint="@color/tile_orange_fg" android:importantForAccessibility="no"/>
                    </FrameLayout>
                    <TextView android:id="@+id/txtStatTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0h 0m" android:fontFeatureSettings="tnum" android:textColor="@color/on_surface" android:textSize="22sp" android:textStyle="bold" android:letterSpacing="-0.02"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/stat_tile_time" android:textColor="@color/on_surface_variant" android:textSize="11.5sp" android:gravity="center" android:layout_marginTop="4dp"/>
                    <TextView android:id="@+id/txtStatKeyword" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" tools:text="0"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- R7.4 — most-used-app suggestion card: top time consumer with a
             one-tap Block. Hidden until usage-access granted and one app
             crossed the suggestion threshold. All ids NEW. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardScreenTimeSuggest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            style="@style/Widget.GuardianShield.Card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingVertical="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/screentime_suggestion_title"
                    android:textColor="@color/on_surface"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp">

                    <ImageView
                        android:id="@+id/imgSuggestIcon"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:scaleType="fitCenter"
                        android:importantForAccessibility="no"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:id="@+id/txtSuggestApp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/on_surface"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:singleLine="true"
                            android:ellipsize="end"/>

                        <TextView
                            android:id="@+id/txtSuggestTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/error"
                            android:textSize="13sp"
                            android:fontFeatureSettings="tnum"/>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSuggestBlock"
                        style="@style/Widget.GuardianShield.Button.Tonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="@string/screentime_block_now"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- PHASE 3 (v3.5.0) — clean streak + weekly comparison. Supportive
             copy only (স্টে স্ট্রং voice); computed read-only from block_events. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/streakCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="20dp"
            style="@style/Widget.GuardianShield.Card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp">
                <FrameLayout
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/tile_purple_bg">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_shield_check"
                        app:tint="@color/tile_purple_fg"
                        android:importantForAccessibility="no"/>
                </FrameLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">
                    <TextView
                        android:id="@+id/txtStreakTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/streak_card_title"
                        android:textColor="@color/on_surface"
                        android:textSize="15sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:id="@+id/txtWeeklyCompare"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/streak_newcomer"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.3"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginStart="12dp">
                    <TextView
                        android:id="@+id/txtStreakDays"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:fontFeatureSettings="tnum"
                        android:textColor="@color/primary_dim"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:letterSpacing="-0.02"
                        tools:text="12"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/streak_days_caption"
                        android:textColor="@color/on_surface_dim"
                        android:textSize="10.5sp"
                        android:gravity="center"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="22dp"
            android:paddingBottom="8dp">
            <TextView
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/todays_activity"
                style="@style/TextAppearance.GuardianShield.SectionHeader"/>
            <TextView
                android:id="@+id/txtSeeAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="@string/see_all"
                android:textColor="@color/primary_dim"
                android:textSize="13sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            style="@style/Widget.GuardianShield.Card">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerRecent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                tools:itemCount="3"/>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
