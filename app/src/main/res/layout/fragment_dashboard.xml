<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:title="🛡️ Guardian Shield" />

        <!-- Hero status card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="16dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_protection_active"
                    android:textSize="20sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/txtAiStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/dashboard_ai_active"
                    android:textColor="@color/safety_green" />
                <TextView
                    android:id="@+id/txtBlockedToday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="0 blocked today"
                    android:textColor="@color/grey_700" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Quick stats row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:weightSum="3">

            <LinearLayout style="@style/StatCard"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginEnd="8dp" android:orientation="vertical">
                <TextView android:id="@+id/statApps" style="@style/StatNumber"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0" />
                <TextView style="@style/StatLabel"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/dashboard_apps" />
            </LinearLayout>

            <LinearLayout style="@style/StatCard"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginHorizontal="4dp" android:orientation="vertical">
                <TextView android:id="@+id/statReels" style="@style/StatNumber"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0" />
                <TextView style="@style/StatLabel"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/dashboard_reels" />
            </LinearLayout>

            <LinearLayout style="@style/StatCard"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="8dp" android:orientation="vertical">
                <TextView android:id="@+id/statSites" style="@style/StatNumber"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0" />
                <TextView style="@style/StatLabel"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/dashboard_sites" />
            </LinearLayout>
        </LinearLayout>

        <!-- Today's Ayah card -->
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/dashboard_todays_ayah"
            android:textSize="14sp" android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            app:cardBackgroundColor="@color/scroll_card"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/islamic_gold"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">
                <TextView android:id="@+id/txtAyahSource"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/islamic_gold" android:textStyle="bold"
                    android:text="" />
                <TextView android:id="@+id/txtAyahArabic"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textSize="22sp" android:textColor="@color/white"
                    android:textDirection="rtl"
                    android:text="" />
                <TextView android:id="@+id/txtAyahTranslation"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/grey_300"
                    android:textStyle="italic"
                    android:text="" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
