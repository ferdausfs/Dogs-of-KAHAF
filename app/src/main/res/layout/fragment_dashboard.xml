<?xml version="1.0" encoding="utf-8"?>
<!-- ONE SHIELD — Home. Bindings preserved. -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="never"
    android:background="@color/bg_main"
    tools:context=".ui.dashboard.fragments.DashboardFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="14dp"
            android:text="@string/home_title"
            android:textAppearance="@style/TextAppearance.GuardianShield.Display"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/statusCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.GuardianShield.Card.Beacon">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="22dp"
                    android:paddingBottom="18dp">

                    <FrameLayout
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/bg_icon_well"
                        android:backgroundTint="@color/beacon_dim">
                        <!-- Pass 2: glow background — the Kotlin alpha pulse
                             (0.3→0.6) now renders as a visible breathing
                             glow. Binding/type unchanged (plain View). -->
                        <View
                            android:id="@+id/shieldGlow"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_glow_accent"
                            android:alpha="0.35"/>
                        <ImageView
                            android:id="@+id/imgShield"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_shield_check"
                            app:tint="@color/primary_dim"
                            android:contentDescription="@null"/>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/txtStatusTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/status_active"
                        android:textColor="@color/on_primary_container"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:letterSpacing="-0.02"
                        android:lineSpacingMultiplier="1.15"/>

                    <TextView
                        android:id="@+id/txtStatusSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/on_primary_container"
                        android:alpha="0.78"
                        android:textSize="13.5sp"
                        android:lineSpacingMultiplier="1.35"
                        android:layout_marginTop="4dp"/>

                    <TextView
                        android:id="@+id/txtProtectionBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="● Protection Active"
                        android:textColor="@color/on_primary_container"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_badge"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"/>

                    <!-- Tonal (not primary): the hero card itself is vivid
                         violet on the light theme — a violet primary button
                         would drown in it. Surface-pill reads as the classic
                         "pause" chip on both themes. -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnToggle"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="18dp"
                        android:text="@string/btn_pause"
                        style="@style/Widget.GuardianShield.Button.Tonal"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                style="@style/Widget.GuardianShield.Card">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="16dp"
                    android:paddingHorizontal="8dp">
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="8dp">
                        <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_circle" android:backgroundTint="@color/tile_purple_bg" android:layout_marginBottom="8dp">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_layers" app:tint="@color/tile_purple_fg" android:importantForAccessibility="no"/>
                    </FrameLayout>
                        <TextView android:id="@+id/txtStatTotal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:fontFeatureSettings="tnum" android:textColor="@color/on_surface" android:textSize="28sp" android:textStyle="bold" android:letterSpacing="-0.02"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/stat_tile_total" android:textColor="@color/on_surface_variant" android:textSize="12sp" android:gravity="center" android:layout_marginTop="4dp"/>
                    </LinearLayout>
                    <!-- Pass 2: hairline column separators (fintech stat sheet) -->
                    <View android:layout_width="1dp" android:layout_height="40dp" android:layout_gravity="center_vertical" android:background="@color/border_subtle"/>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="8dp">
                        <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_circle" android:backgroundTint="@color/tile_blue_bg" android:layout_marginBottom="8dp">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_ai_spark" app:tint="@color/tile_blue_fg" android:importantForAccessibility="no"/>
                    </FrameLayout>
                        <TextView android:id="@+id/txtStatAi" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:fontFeatureSettings="tnum" android:textColor="@color/on_surface" android:textSize="28sp" android:textStyle="bold" android:letterSpacing="-0.02"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/stat_tile_ai" android:textColor="@color/on_surface_variant" android:textSize="12sp" android:gravity="center" android:layout_marginTop="4dp"/>
                    </LinearLayout>
                    <View android:layout_width="1dp" android:layout_height="40dp" android:layout_gravity="center_vertical" android:background="@color/border_subtle"/>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="8dp">
                        <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_circle" android:backgroundTint="@color/tile_orange_bg" android:layout_marginBottom="8dp">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_clock" app:tint="@color/tile_orange_fg" android:importantForAccessibility="no"/>
                    </FrameLayout>
                        <TextView android:id="@+id/txtStatTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0h 0m" android:fontFeatureSettings="tnum" android:textColor="@color/on_surface" android:textSize="24sp" android:textStyle="bold" android:letterSpacing="-0.02"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/stat_tile_time" android:textColor="@color/on_surface_variant" android:textSize="12sp" android:gravity="center" android:layout_marginTop="4dp"/>
                        <TextView android:id="@+id/txtStatKeyword" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" tools:text="0"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- PHASE 3 (v3.5.0) — clean streak + weekly comparison. Supportive
                 copy only (স্টে স্ট্রং voice); computed read-only from block_events. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/streakCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                style="@style/Widget.GuardianShield.Card">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="16dp">
                    <FrameLayout
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_icon_well">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_shield_check"
                            app:tint="@color/primary_dim"
                            android:importantForAccessibility="no"/>
                    </FrameLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">
                        <TextView
                            android:id="@+id/txtStreakTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/streak_card_title"
                            android:textColor="@color/on_surface"
                            android:textSize="15sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:id="@+id/txtWeeklyCompare"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/streak_newcomer"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="13sp"
                            android:lineSpacingMultiplier="1.3"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginStart="12dp">
                        <TextView
                            android:id="@+id/txtStreakDays"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:fontFeatureSettings="tnum"
                            android:textColor="@color/primary_dim"
                            android:textSize="26sp"
                            android:textStyle="bold"
                            android:letterSpacing="-0.02"
                            tools:text="12"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/streak_days_caption"
                            android:textColor="@color/on_surface_dim"
                            android:textSize="10.5sp"
                            android:gravity="center"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:paddingTop="22dp"
            android:paddingBottom="8dp"
            android:text="@string/quick_actions"
            style="@style/TextAppearance.GuardianShield.SectionHeader"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            style="@style/Widget.GuardianShield.Card">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:id="@+id/cardAppBlocking" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="72dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:paddingVertical="12dp" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">
                    <!-- Pass 2: 44dp accent well around the glyph -->
                    <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_icon_well" android:backgroundTint="@color/tile_blue_bg">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/ic_apps" app:tint="@color/tile_blue_fg" android:importantForAccessibility="no"/>
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/quick_apps_title" android:textColor="@color/on_surface" android:textSize="16sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/quick_apps_sub" android:textColor="@color/on_surface_variant" android:textSize="13sp"/>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/on_surface_dim" android:textSize="22sp"/>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border_subtle" android:layout_marginStart="74dp"/>
                <LinearLayout android:id="@+id/cardKeywords" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="72dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:paddingVertical="12dp" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">
                    <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_icon_well" android:backgroundTint="@color/tile_purple_bg">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/ic_keyword" app:tint="@color/tile_purple_fg" android:importantForAccessibility="no"/>
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/quick_keywords_title" android:textColor="@color/on_surface" android:textSize="16sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/quick_keywords_sub" android:textColor="@color/on_surface_variant" android:textSize="13sp"/>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/on_surface_dim" android:textSize="22sp"/>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border_subtle" android:layout_marginStart="74dp"/>
                <LinearLayout android:id="@+id/cardWhitelist" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="72dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:paddingVertical="12dp" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">
                    <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_icon_well" android:backgroundTint="@color/tile_green_bg">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/ic_shield_check" app:tint="@color/tile_green_fg" android:importantForAccessibility="no"/>
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/whitelist" android:textColor="@color/on_surface" android:textSize="16sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/quick_whitelist_sub" android:textColor="@color/on_surface_variant" android:textSize="13sp"/>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/on_surface_dim" android:textSize="22sp"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="22dp"
            android:paddingBottom="8dp">
            <TextView
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/todays_activity"
                style="@style/TextAppearance.GuardianShield.SectionHeader"/>
            <TextView
                android:id="@+id/txtSeeAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="@string/see_all"
                android:textColor="@color/primary_dim"
                android:textSize="13sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            style="@style/Widget.GuardianShield.Card">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerRecent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                tools:itemCount="3"/>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
