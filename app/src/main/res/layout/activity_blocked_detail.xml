<?xml version="1.0" encoding="utf-8"?>
<!-- ONE SHIELD (One UI 8, color rev r2) — Blocked Content Detail.
     Was: WATCHTOWER V3 (red halo header, four separate icon-well cards with
     uppercase kickers + category spine, icon rows).
     Now matches guardian-redesign/mocks/oneui8/overlays.html frame C:
     hero off card (r2 error gradient + top-edge light + soft glow), ONE info
     sheet with hairline rows, "What you can do" sheet with text rows +
     chevrons, grouped bottom actions.
     Bindings preserved EXACTLY: toolbar txtApp txtCategory txtSource txtTime
     rowStayFocused rowViewActivity rowWhitelist btnBackToApp btnReport —
     destinations unchanged (HOME / ActivityLog / AppList / finish). -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bg_main"
        app:title=""
        app:titleTextColor="@color/on_surface"
        app:navigationIconTint="@color/on_surface"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="30dp">

            <!-- hero off (r2: error gradient + top-edge light + soft glow) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@drawable/bg_hero_error"
                android:paddingHorizontal="22dp"
                android:paddingVertical="26dp">
                <FrameLayout
                    android:layout_width="52dp" android:layout_height="52dp"
                    android:background="@drawable/bg_icon_well"
                    android:backgroundTint="@color/error_container">
                    <ImageView android:layout_width="26dp" android:layout_height="26dp"
                        android:layout_gravity="center" android:src="@drawable/ic_shield_alert"
                        app:tint="@color/error_bright" android:importantForAccessibility="no"/>
                </FrameLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/overlay_blocked_content"
                    android:textColor="@color/on_surface"
                    android:textSize="22sp" android:textStyle="bold" android:letterSpacing="-0.02"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:maxWidth="290dp"
                    android:text="@string/overlay_you_are_safe"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="13.5sp" android:lineSpacingMultiplier="1.4"
                    android:gravity="center"/>
            </LinearLayout>

            <!-- info sheet: hairline rows, label + value -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                style="@style/Widget.GuardianShield.Card">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:minHeight="60dp"
                        android:gravity="center_vertical"
                        android:paddingVertical="10dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/detail_app"
                            android:textColor="@color/on_surface_variant" android:textSize="13sp"/>
                        <TextView android:id="@+id/txtApp"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="2dp" android:fontFamily="monospace"
                            android:textColor="@color/on_surface" android:textSize="15sp"
                            android:textStyle="bold" android:maxLines="1" android:ellipsize="middle"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/border_subtle"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:minHeight="60dp"
                        android:gravity="center_vertical"
                        android:paddingVertical="10dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/overlay_blocked_category"
                            android:textColor="@color/on_surface_variant" android:textSize="13sp"/>
                        <TextView android:id="@+id/txtCategory"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/on_surface" android:textSize="15sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/border_subtle"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:minHeight="60dp"
                        android:gravity="center_vertical"
                        android:paddingVertical="10dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/detail_source"
                            android:textColor="@color/on_surface_variant" android:textSize="13sp"/>
                        <TextView android:id="@+id/txtSource"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="2dp" android:fontFamily="monospace"
                            android:textColor="@color/on_surface_variant" android:textSize="12sp"
                            android:maxLines="1" android:ellipsize="middle"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/border_subtle"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:minHeight="60dp"
                        android:gravity="center_vertical"
                        android:paddingVertical="10dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/overlay_time"
                            android:textColor="@color/on_surface_variant" android:textSize="13sp"/>
                        <TextView android:id="@+id/txtTime"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="2dp" android:fontFeatureSettings="tnum"
                            android:textColor="@color/on_surface" android:textSize="15sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- what you can do -->
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="22dp" android:layout_marginBottom="8dp"
                android:text="@string/detail_what_you_can_do"
                style="@style/TextAppearance.GuardianShield.SectionHeader"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.GuardianShield.Card">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/rowStayFocused"
                        android:layout_width="match_parent" android:layout_height="64dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true" android:focusable="true">
                        <TextView android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="@string/detail_stay_focused"
                            android:textColor="@color/on_surface" android:textSize="16sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="›" android:textColor="@color/on_surface_dim" android:textSize="22sp"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/border_subtle"/>

                    <LinearLayout
                        android:id="@+id/rowViewActivity"
                        android:layout_width="match_parent" android:layout_height="64dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true" android:focusable="true">
                        <TextView android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="@string/detail_view_activity"
                            android:textColor="@color/on_surface" android:textSize="16sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="›" android:textColor="@color/on_surface_dim" android:textSize="22sp"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/border_subtle"/>

                    <LinearLayout
                        android:id="@+id/rowWhitelist"
                        android:layout_width="match_parent" android:layout_height="64dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true" android:focusable="true">
                        <TextView android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="@string/detail_whitelist"
                            android:textColor="@color/on_surface" android:textSize="16sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="›" android:textColor="@color/on_surface_dim" android:textSize="22sp"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBackToApp"
                style="@style/Widget.GuardianShield.Button.Danger"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="22dp"
                android:text="@string/detail_back_to_app"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReport"
                style="@style/Widget.GuardianShield.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:text="@string/overlay_report_close"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
