<?xml version="1.0" encoding="utf-8"?>
<!-- WATCHTOWER V3 — activity event row (category spine + tabular time)
     Binding contract preserved: badge imgAppIcon txtPackage txtReason
     txtTimeInline txtBadgeBlocked txtTime (same widget classes). -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    style="@style/Widget.GuardianShield.Card.Row"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp">

        <!-- category spine — tinted in code (setBackgroundTintList) -->
        <View
            android:id="@+id/badge"
            android:layout_width="3.5dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_spine"/>

        <ImageView
            android:id="@+id/imgAppIcon"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="12dp"
            android:scaleType="fitCenter"
            android:contentDescription="@null"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtReason"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/on_surface"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/txtPackage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/on_surface_dim"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="middle"/>

            <TextView
                android:id="@+id/txtTimeInline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:text="09:41"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:layout_marginStart="10dp">

            <TextView
                android:id="@+id/txtBadgeBlocked"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge"
                android:backgroundTint="@color/badge_error_bg"
                android:textColor="@color/error"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                tools:text="AI Blocked"/>

            <TextView
                android:id="@+id/txtTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/on_surface_dim"
                android:fontFeatureSettings="tnum"
                android:textSize="11.5sp"
                tools:text="09:41"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
