<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/surface_high"
    app:strokeWidth="0dp">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="16dp">

    <View android:id="@+id/badge"
        android:layout_width="4dp" android:layout_height="40dp"
        android:background="@drawable/bg_badge"
        android:backgroundTint="@color/primary"
        android:layout_marginEnd="16dp"/>

    <ImageView android:id="@+id/imgAppIcon"
        android:layout_width="36dp" android:layout_height="36dp"
        android:src="@drawable/ic_app_placeholder"
        android:layout_marginEnd="12dp"
        android:contentDescription="@null"/>

    <LinearLayout
        android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView android:id="@+id/txtPackage"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/on_surface" android:textSize="14sp"
            android:textStyle="bold" android:singleLine="true" android:ellipsize="end"/>
        <TextView android:id="@+id/txtReason"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/on_surface_dim" android:textSize="12sp"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <TextView android:id="@+id/txtTime"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/on_surface_variant" android:textSize="12sp"
        android:layout_marginStart="8dp"/>
</LinearLayout>
</com.google.android.material.card.MaterialCardView>
