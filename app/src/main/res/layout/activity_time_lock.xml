<?xml version="1.0" encoding="utf-8"?>
<!-- WATCHTOWER V3 — Commitment Lock (approved: mocks/v3/rules.html frame D)
     Bindings preserved: toolbar groupLocked txtLockStatus txtLockLabel
     txtRemaining txtLockEnd txtCooldownNote btnRequestUnlock groupUnlocked
     chip1day chip3day chip7day chip15day chip30day. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bg_main"
        app:title="@string/btn_commitment_lock"
        app:titleTextColor="@color/on_surface"
        app:titleTextAppearance="@style/TextAppearance.GuardianShield.Title"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="36dp">

            <!-- ======== LOCKED STATE ======== -->
            <LinearLayout
                android:id="@+id/groupLocked"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.GuardianShield.Card.Amber">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingHorizontal="22dp"
                        android:paddingVertical="28dp">

                        <FrameLayout
                            android:layout_width="96dp" android:layout_height="96dp"
                            android:background="@drawable/bg_halo_amber">
                            <ImageView
                                android:layout_width="38dp" android:layout_height="38dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_time_lock"
                                app:tint="@color/warning_amber"
                                android:importantForAccessibility="no"/>
                        </FrameLayout>

                        <TextView
                            android:id="@+id/txtLockStatus"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:textColor="@color/on_warning_container"
                            android:textSize="20sp" android:textStyle="bold" android:letterSpacing="-0.01"
                            tools:text="Commitment Lock active"/>

                        <TextView
                            android:id="@+id/txtLockLabel"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:textColor="@color/on_warning_container"
                            android:alpha="0.75" android:textSize="12.5sp"
                            tools:text="সেটিংস পরিবর্তন বন্ধ"/>

                        <TextView
                            android:id="@+id/txtRemaining"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:textColor="@color/on_warning_container"
                            android:textSize="44sp" android:textStyle="bold" android:letterSpacing="-0.025"
                            android:fontFeatureSettings="tnum"
                            tools:text="2d 14:05"/>

                        <TextView
                            android:id="@+id/txtLockEnd"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/on_warning_container"
                            android:alpha="0.6" android:textSize="11sp"
                            android:fontFeatureSettings="tnum"
                            tools:text="ends Fri, Aug 21 · 09:41"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    style="@style/Widget.GuardianShield.Card">
                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="16dp">
                        <TextView
                            android:id="@+id/txtCooldownNote"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="12.5sp" android:lineSpacingMultiplier="1.5"
                            tools:text="Unlock requests are limited — cooldown applies."/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRequestUnlock"
                            style="@style/Widget.GuardianShield.Button.Tonal"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="14dp"
                            android:text="@string/overlay_request_unlock"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ======== UNLOCKED STATE ======== -->
            <LinearLayout
                android:id="@+id/groupUnlocked"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.GuardianShield.Card.Beacon">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingHorizontal="22dp"
                        android:paddingVertical="28dp">

                        <FrameLayout
                            android:layout_width="96dp" android:layout_height="96dp"
                            android:background="@drawable/bg_halo_beacon">
                            <ImageView
                                android:layout_width="38dp" android:layout_height="38dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_shield_on"
                                android:importantForAccessibility="no"/>
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/lock_choose_duration"
                            android:textColor="@color/on_primary_container"
                            android:textSize="20sp" android:textStyle="bold" android:letterSpacing="-0.01"/>
                        <TextView
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="@string/lock_choose_sub"
                            android:textColor="@color/on_primary_container"
                            android:alpha="0.75" android:textSize="12.5sp"
                            android:gravity="center"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="24dp" android:layout_marginBottom="12dp"
                    android:text="@string/lock_choose_duration"
                    style="@style/TextAppearance.GuardianShield.SectionHeader"/>

                <com.google.android.material.chip.ChipGroup
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleSelection="true" app:selectionRequired="true"
                    app:chipSpacingHorizontal="8dp">
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip1day" style="@style/Widget.GuardianShield.Chip.Filter"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/lock_1day" android:checkable="true"/>
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip3day" style="@style/Widget.GuardianShield.Chip.Filter"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/lock_3day" android:checkable="true"/>
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip7day" style="@style/Widget.GuardianShield.Chip.Filter"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/lock_7day" android:checkable="true"/>
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip15day" style="@style/Widget.GuardianShield.Chip.Filter"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/lock_15day" android:checkable="true"/>
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip30day" style="@style/Widget.GuardianShield.Chip.Filter"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/lock_30day" android:checkable="true"/>
                </com.google.android.material.chip.ChipGroup>

                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/lock_tap_hint"
                    android:textColor="@color/on_surface_dim"
                    android:textSize="11.5sp" android:lineSpacingMultiplier="1.4"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
