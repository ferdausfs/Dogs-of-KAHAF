<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bg_main"
        app:title="Commitment Lock"
        app:titleTextColor="@color/on_surface"
        app:navigationIcon="@drawable/ic_arrow_back"/>

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- ══════════════════════════════════════════
                 LOCKED / COOLDOWN STATE
            ══════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/groupLocked"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔒"
                    android:textSize="64sp"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:id="@+id/txtLockStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FF4444"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:gravity="center"/>

                <TextView
                    android:id="@+id/txtLockLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/on_surface_dim"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"/>

                <!-- Countdown card (cooldown চলাকালীন) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="16dp"
                    android:layout_marginTop="20dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="বাকি সময়"
                            android:textColor="@color/on_surface_dim"
                            android:textSize="12sp"
                            android:textAllCaps="true"
                            android:letterSpacing="0.08"/>
                        <TextView
                            android:id="@+id/txtRemaining"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/primary"
                            android:textSize="26sp"
                            android:textStyle="bold"
                            android:layout_marginTop="6dp"/>
                        <TextView
                            android:id="@+id/txtLockEnd"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/on_surface_dim"
                            android:textSize="13sp"
                            android:layout_marginTop="8dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Cooldown note (cooldown চলাকালীন দেখাবে) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#1A4CAF50"
                    app:cardCornerRadius="12dp"
                    android:layout_marginTop="16dp">
                    <TextView
                        android:id="@+id/txtCooldownNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:text="⏳ Cooldown চলছে — সময় শেষ হলে স্বয়ংক্রিয়ভাবে unlock হয়ে যাবে। Stay strong! 💪"
                        android:textColor="#4CAF50"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.4"
                        android:visibility="gone"/>
                </com.google.android.material.card.MaterialCardView>

                <!-- Unlock request button (LOCKED state এ দেখাবে, COOLDOWN এ নয়) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRequestUnlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="🔓 Unlock Request করুন"
                    android:textColor="@color/on_surface"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:visibility="gone"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Unlock request দিলে cooldown শুরু হবে। Cooldown শেষে lock উঠবে।"
                    android:textColor="@color/on_surface_dim"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.4"
                    android:layout_marginTop="16dp"/>

            </LinearLayout>

            <!-- ══════════════════════════════════════════
                 UNLOCKED STATE — duration picker
            ══════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/groupUnlocked"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛡️ Commitment Lock"
                    android:textColor="@color/on_surface"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cooldown duration বেছে নিন। Lock করার পর কোনো setting বদলানো যাবে না। Unlock করতে চাইলে request দিতে হবে — তারপর এই duration শেষে lock উঠবে।"
                    android:textColor="@color/on_surface_dim"
                    android:textSize="14sp"
                    android:lineSpacingMultiplier="1.4"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="24dp"/>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="16dp"
                    android:layout_marginBottom="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cooldown Duration"
                            android:textColor="@color/on_surface_dim"
                            android:textSize="12sp"
                            android:textAllCaps="true"
                            android:letterSpacing="0.08"
                            android:layout_marginBottom="12dp"/>
                        <com.google.android.material.chip.ChipGroup
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip1day"
                                style="@style/Widget.Material3.Chip.Suggestion"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="১ দিন"/>
                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip3day"
                                style="@style/Widget.Material3.Chip.Suggestion"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="৩ দিন"/>
                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip7day"
                                style="@style/Widget.Material3.Chip.Suggestion"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="৭ দিন"/>
                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip15day"
                                style="@style/Widget.Material3.Chip.Suggestion"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="১৫ দিন"/>
                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip30day"
                                style="@style/Widget.Material3.Chip.Suggestion"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="৩০ দিন"/>
                        </com.google.android.material.chip.ChipGroup>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#1AFF8C00"
                    app:cardCornerRadius="12dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:text="⚠️ Lock করার পর শুধু Unlock Request দিয়ে cooldown শুরু করা যাবে। Cooldown শেষে lock উঠবে — আগে নয়।"
                        android:textColor="#FF8C00"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.4"/>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
