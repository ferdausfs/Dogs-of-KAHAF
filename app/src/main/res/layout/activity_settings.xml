<?xml version="1.0" encoding="utf-8"?>
<!-- ONE SHIELD — Settings. All control IDs preserved. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bg_main"
        app:title=""
        app:titleTextColor="@color/on_surface"
        app:navigationIconTint="@color/on_surface"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="36dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingBottom="10dp"
                android:text="@string/settings_title"
                android:textAppearance="@style/TextAppearance.GuardianShield.Display"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp">

                <LinearLayout
                    android:id="@+id/lockBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_lock_banner"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp"
                    android:layout_marginBottom="14dp"
                    android:visibility="gone"
                    tools:visibility="gone">
                    <ImageView android:layout_width="19dp" android:layout_height="19dp" android:src="@drawable/ic_time_lock" app:tint="@color/warning_amber" android:importantForAccessibility="no"/>
                    <TextView android:id="@+id/txtLockRemaining" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:textColor="@color/on_warning_container" android:textSize="13sp" android:textStyle="bold"/>
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="@string/section_protection" style="@style/TextAppearance.GuardianShield.SectionHeader"/>
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.GuardianShield.Card">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp">
                            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/keyword_filter" android:textColor="@color/on_surface" android:textSize="16sp" android:textStyle="bold"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/keyword_filter_sub" android:textColor="@color/on_surface_variant" android:textSize="13sp"/>
                            </LinearLayout>
                            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchKeyword" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border_subtle" android:layout_marginStart="16dp"/>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp">
                            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ai_detection" android:textColor="@color/on_surface" android:textSize="16sp" android:textStyle="bold"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ai_detection_sub" android:textColor="@color/on_surface_variant" android:textSize="13sp"/>
                            </LinearLayout>
                            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchAi" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border_subtle" android:layout_marginStart="16dp"/>
                        <!-- PHASE 4c (v3.5.0) — opt-in notification shade shield -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp">
                            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingEnd="12dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/notif_shield_title" android:textColor="@color/on_surface" android:textSize="16sp" android:textStyle="bold"/>
                                <TextView android:id="@+id/txtNotifShieldSub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/notif_shield_sub_off" android:textColor="@color/on_surface_variant" android:textSize="13sp" android:lineSpacingMultiplier="1.3"/>
                            </LinearLayout>
                            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchNotifShield" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:layout_marginBottom="10dp" android:text="@string/unlock_delay" style="@style/TextAppearance.GuardianShield.SectionHeader"/>
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" style="@style/Widget.GuardianShield.Card">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/unlock_delay" android:textColor="@color/on_surface" android:textSize="16sp" android:textStyle="bold"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/unlock_delay_sub" android:textColor="@color/on_surface_variant" android:textSize="13sp"/>
                            </LinearLayout>
                            <TextView android:id="@+id/txtDelayValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_badge" android:textColor="@color/on_surface" android:fontFeatureSettings="tnum" android:textSize="13sp" android:textStyle="bold" android:paddingHorizontal="10dp" android:paddingVertical="4dp" tools:text="30s"/>
                        </LinearLayout>
                        <com.google.android.material.slider.Slider android:id="@+id/sliderDelay" android:layout_width="match_parent" android:layout_height="wrap_content" android:valueFrom="5" android:valueTo="120" android:stepSize="5" app:tickVisible="false" android:layout_marginTop="10dp"/>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5s" android:textColor="@color/on_surface_dim" android:textSize="11sp"/>
                            <Space android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="120s" android:textColor="@color/on_surface_dim" android:textSize="11sp"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.GuardianShield.Card">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/section_temp_block" android:textColor="@color/on_surface" android:textSize="16sp" android:textStyle="bold"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/temp_block_info" android:textColor="@color/on_surface_variant" android:textSize="13sp" android:lineSpacingMultiplier="1.45"/>
                        <com.google.android.material.chip.ChipGroup android:id="@+id/chipGroupBlockDuration" android:layout_width="match_parent" android:layout_height="wrap_content" app:singleSelection="true" app:selectionRequired="true" app:chipSpacingHorizontal="8dp" android:layout_marginTop="12dp">
                            <com.google.android.material.chip.Chip android:id="@+id/chip15min" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/duration_15" android:checkable="true" style="@style/Widget.GuardianShield.Chip.Filter"/>
                            <com.google.android.material.chip.Chip android:id="@+id/chip30min" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/duration_30" android:checkable="true" style="@style/Widget.GuardianShield.Chip.Filter"/>
                            <com.google.android.material.chip.Chip android:id="@+id/chip60min" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/duration_60" android:checkable="true" style="@style/Widget.GuardianShield.Chip.Filter"/>
                        </com.google.android.material.chip.ChipGroup>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:layout_marginBottom="10dp" android:text="@string/section_rules" style="@style/TextAppearance.GuardianShield.SectionHeader"/>
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.GuardianShield.Card">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="4dp">
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnApps" style="@style/Widget.GuardianShield.SettingsRow" android:layout_width="match_parent" android:layout_height="64dp" android:text="@string/btn_apps" app:icon="@drawable/ic_apps" app:iconTint="@color/primary_dim" app:iconGravity="textStart"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnKeywords" style="@style/Widget.GuardianShield.SettingsRow" android:layout_width="match_parent" android:layout_height="64dp" android:text="@string/btn_keywords" app:icon="@drawable/ic_keyword" app:iconTint="@color/primary_dim" app:iconGravity="textStart"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnSchedule" style="@style/Widget.GuardianShield.SettingsRow" android:layout_width="match_parent" android:layout_height="64dp" android:text="@string/btn_schedule" app:icon="@drawable/ic_clock" app:iconTint="@color/primary_dim" app:iconGravity="textStart"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnPermissions" style="@style/Widget.GuardianShield.SettingsRow" android:layout_width="match_parent" android:layout_height="64dp" android:text="@string/btn_permissions" app:icon="@drawable/ic_access" app:iconTint="@color/primary_dim" app:iconGravity="textStart"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnCommitmentLock" style="@style/Widget.GuardianShield.SettingsRow" android:layout_width="match_parent" android:layout_height="64dp" android:text="@string/btn_commitment_lock" app:icon="@drawable/ic_time_lock" app:iconTint="@color/primary_dim" app:iconGravity="textStart"/>
                        <!-- TASK B — pending reports (cooling-off queue viewer) -->
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnPendingReports" style="@style/Widget.GuardianShield.SettingsRow" android:layout_width="match_parent" android:layout_height="64dp" android:text="@string/pending_reports_title" app:icon="@drawable/ic_flag" app:iconTint="@color/primary_dim" app:iconGravity="textStart"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:layout_marginBottom="10dp" android:text="@string/section_ai_v3" style="@style/TextAppearance.GuardianShield.SectionHeader"/>
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" style="@style/Widget.GuardianShield.Card">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ai_sensitivity" android:textColor="@color/on_surface" android:textSize="16sp" android:textStyle="bold"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ai_sensitivity_sub" android:textColor="@color/on_surface_variant" android:textSize="13sp"/>
                            </LinearLayout>
                            <TextView android:id="@+id/txtGuardianThresholdValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_badge" android:textColor="@color/primary_dim" android:fontFeatureSettings="tnum" android:textSize="13sp" android:textStyle="bold" android:paddingHorizontal="10dp" android:paddingVertical="4dp" tools:text="0.72"/>
                        </LinearLayout>
                        <com.google.android.material.slider.Slider android:id="@+id/sliderGuardianThreshold" android:layout_width="match_parent" android:layout_height="wrap_content" android:valueFrom="0.30" android:valueTo="0.95" android:stepSize="0.01" app:tickVisible="false" android:layout_marginTop="10dp"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ai_sensitivity_note" android:textColor="@color/on_surface_dim" android:textSize="12sp" android:lineSpacingMultiplier="1.4"/>
                        <com.google.android.material.chip.ChipGroup android:id="@+id/chipGroupGridVote" android:layout_width="match_parent" android:layout_height="wrap_content" app:singleSelection="true" app:selectionRequired="true" app:chipSpacingHorizontal="8dp" android:layout_marginTop="12dp">
                            <com.google.android.material.chip.Chip android:id="@+id/chipVote1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/vote_1" android:checkable="true" style="@style/Widget.GuardianShield.Chip.Filter"/>
                            <com.google.android.material.chip.Chip android:id="@+id/chipVote2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/vote_2" android:checkable="true" style="@style/Widget.GuardianShield.Chip.Filter"/>
                            <com.google.android.material.chip.Chip android:id="@+id/chipVote3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/vote_3" android:checkable="true" style="@style/Widget.GuardianShield.Chip.Filter"/>
                            <com.google.android.material.chip.Chip android:id="@+id/chipVote4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/vote_4" android:checkable="true" style="@style/Widget.GuardianShield.Chip.Filter"/>
                        </com.google.android.material.chip.ChipGroup>

                        <!-- v3.6.0 — ConfirmedSensitiveMemory visibility (Task D).
                             Read-only count: the store is deliberately one-way
                             (no browse/remove UI). -->
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="14dp" android:background="@color/border_subtle"/>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="12dp">
                            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/confirmed_count_label" android:textColor="@color/on_surface" android:textSize="14sp" android:textStyle="bold"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/confirmed_count_sub" android:textColor="@color/on_surface_variant" android:textSize="11.5sp" android:lineSpacingMultiplier="1.3" android:layout_marginTop="2dp"/>
                            </LinearLayout>
                            <TextView android:id="@+id/txtConfirmedCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_badge" android:backgroundTint="@color/badge_success_bg" android:textColor="@color/success_legacy" android:fontFeatureSettings="tnum" android:textSize="13sp" android:textStyle="bold" android:paddingHorizontal="10dp" android:paddingVertical="4dp" tools:text="0"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.GuardianShield.Card">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/legacy_model" android:textColor="@color/on_surface" android:textSize="16sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/txtLegacyStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/on_surface_variant" android:textSize="13sp" tools:text="✗ Missing"/>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="14dp">
                            <com.google.android.material.button.MaterialButton android:id="@+id/btnImportLegacy" style="@style/Widget.GuardianShield.Button.Small" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:layout_marginEnd="5dp" android:text="@string/import_"/>
                            <com.google.android.material.button.MaterialButton android:id="@+id/btnRemoveLegacy" style="@style/Widget.GuardianShield.Button.Small" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:layout_marginStart="5dp" android:text="@string/remove"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:layout_marginBottom="10dp" android:text="@string/section_security" style="@style/TextAppearance.GuardianShield.SectionHeader"/>
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.GuardianShield.Card">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnChangePin" style="@style/Widget.GuardianShield.SettingsRow" android:layout_width="match_parent" android:layout_height="64dp" android:text="@string/btn_change_pin" app:icon="@drawable/ic_lock" app:iconTint="@color/primary_dim" app:iconGravity="textStart"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnRecoveryInfo" style="@style/Widget.GuardianShield.SettingsRow" android:layout_width="match_parent" android:layout_height="64dp" android:text="@string/btn_recovery_code" app:icon="@drawable/ic_history" app:iconTint="@color/primary_dim" app:iconGravity="textStart"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- PHASE 2 (v3.5.0) — accountability partner -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:layout_marginBottom="10dp" android:text="@string/section_accountability" style="@style/TextAppearance.GuardianShield.SectionHeader"/>
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.GuardianShield.Card">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnPartner" style="@style/Widget.GuardianShield.SettingsRow" android:layout_width="match_parent" android:layout_height="64dp" android:text="@string/btn_partner" app:icon="@drawable/ic_access" app:iconTint="@color/primary_dim" app:iconGravity="textStart"/>
                        <TextView android:id="@+id/txtPartnerStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="16dp" android:paddingBottom="10dp" android:textColor="@color/on_surface_variant" android:textSize="12.5sp" android:lineSpacingMultiplier="1.35"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnPartnerSummary" style="@style/Widget.GuardianShield.SettingsRow" android:layout_width="match_parent" android:layout_height="64dp" android:text="@string/btn_partner_summary" app:icon="@drawable/ic_export" app:iconTint="@color/primary_dim" app:iconGravity="textStart"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- PHASE 4a (v3.5.0) — local backup/restore (rules + settings only;
                     PIN/time-lock/detection history are never exported). -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:layout_marginBottom="10dp" android:text="@string/section_backup" style="@style/TextAppearance.GuardianShield.SectionHeader"/>
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.GuardianShield.Card">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnBackupExport" style="@style/Widget.GuardianShield.SettingsRow" android:layout_width="match_parent" android:layout_height="64dp" android:text="@string/btn_backup_export" app:icon="@drawable/ic_export" app:iconTint="@color/primary_dim" app:iconGravity="textStart"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnBackupImport" style="@style/Widget.GuardianShield.SettingsRow" android:layout_width="match_parent" android:layout_height="64dp" android:text="@string/btn_backup_import" app:icon="@drawable/ic_import" app:iconTint="@color/primary_dim" app:iconGravity="textStart"/>
                        <TextView android:id="@+id/txtBackupStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="16dp" android:paddingBottom="10dp" android:text="@string/backup_status_hint" android:textColor="@color/on_surface_dim" android:textSize="12sp" android:lineSpacingMultiplier="1.35"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- PHASE 4b (v3.5.0) — Help & FAQ. Read-only: stays usable even
                     during a Time-Lock, so it is NOT in the lock-disable list. -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:layout_marginBottom="10dp" android:text="@string/section_help" style="@style/TextAppearance.GuardianShield.SectionHeader"/>
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.GuardianShield.Card">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnHelp" style="@style/Widget.GuardianShield.SettingsRow" android:layout_width="match_parent" android:layout_height="64dp" android:text="@string/btn_help" app:icon="@drawable/ic_help" app:iconTint="@color/primary_dim" app:iconGravity="textStart"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:gravity="center" android:text="@string/settings_footer" android:textColor="@color/on_surface_dim" android:textSize="11sp" android:letterSpacing="0.08"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
