<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bg_main"
        app:title="Settings • সেটিংস"
        app:titleTextColor="@color/on_surface"
        app:navigationIcon="@drawable/ic_arrow_back"/>

    <!-- Lock banner -->
    <LinearLayout
        android:id="@+id/lockBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="@color/warning_container"
        android:visibility="gone">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_lock"
            android:importantForAccessibility="no"
            app:tint="@color/warning_amber"
            android:contentDescription="@null"/>

        <TextView
            android:id="@+id/txtLockRemaining"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textColor="@color/warning_amber"
            android:textSize="13sp"
            android:textStyle="bold"
            android:text=""/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- PROTECTION -->
            <TextView
                style="@style/TextAppearance.GuardianShield.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_protection"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface_high"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_subtle"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchKeyword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/keyword_filter"
                        android:textColor="@color/on_surface"/>

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        app:dividerColor="@color/border_subtle"/>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchAi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ai_detection"
                        android:textColor="@color/on_surface"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/unlock_delay"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="12sp"
                        android:layout_marginTop="16dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderDelay"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:valueFrom="5"
                            android:valueTo="120"
                            android:stepSize="5"
                            android:value="30"/>

                        <TextView
                            android:id="@+id/txtDelayValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="30s"
                            android:textColor="@color/primary"
                            android:background="@drawable/bg_badge"
                            android:backgroundTint="@color/surface_variant"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:textSize="12sp"
                            android:minWidth="52dp"
                            android:gravity="center"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- TEMP BLOCK DURATION -->
            <TextView
                style="@style/TextAppearance.GuardianShield.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_temp_block"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface_high"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_subtle"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/temp_block_info"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="12sp"
                        android:lineSpacingMultiplier="1.2"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupBlockDuration"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:selectionRequired="true"
                        app:chipSpacingHorizontal="8dp">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip15min"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="১৫ মিনিট"
                            android:checked="true"/>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip30min"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="৩০ মিনিট"/>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip60min"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="১ ঘণ্টা"/>
                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- BLOCKING RULES -->
            <TextView
                style="@style/TextAppearance.GuardianShield.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_rules"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface_high"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_subtle"
                app:strokeWidth="1dp"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnApps"
                        style="@style/Widget.GuardianShield.ButtonTonal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="App List • অ্যাপ তালিকা"
                        android:layout_margin="4dp"
                        app:icon="@drawable/ic_block"
                        app:iconGravity="textStart"
                        app:iconTint="@color/success"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnKeywords"
                        style="@style/Widget.GuardianShield.ButtonTonal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Keywords • কিওয়ার্ড"
                        android:layout_margin="4dp"
                        app:icon="@drawable/ic_key"
                        app:iconGravity="textStart"
                        app:iconTint="@color/info"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSchedule"
                        style="@style/Widget.GuardianShield.ButtonTonal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Schedule • সময়সূচী"
                        android:layout_margin="4dp"
                        app:icon="@drawable/ic_timer"
                        app:iconGravity="textStart"
                        app:iconTint="@color/warning_amber"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPermissions"
                        style="@style/Widget.GuardianShield.ButtonTonal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Permission Health • অনুমতি"
                        android:layout_margin="4dp"
                        app:icon="@drawable/ic_accessibility"
                        app:iconGravity="textStart"
                        app:iconTint="@color/on_surface_variant"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCommitmentLock"
                        style="@style/Widget.GuardianShield.ButtonTonal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Commitment Lock • কমিটেড লক"
                        android:layout_margin="4dp"
                        app:icon="@drawable/ic_lock"
                        app:iconGravity="textStart"
                        app:iconTint="@color/warning_amber"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- AI SENSITIVITY -->
            <TextView
                style="@style/TextAppearance.GuardianShield.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI Sensitivity • সংবেদনশীলতা"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface_high"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_subtle"
                app:strokeWidth="1dp"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Guardian Model Threshold"
                            android:textColor="@color/on_surface"
                            android:textSize="13sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/txtGuardianThresholdValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.72"
                            android:textColor="@color/ai_detection_color"
                            android:background="@drawable/bg_badge"
                            android:backgroundTint="@color/badge_ai_bg"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:textSize="12sp"
                            android:gravity="end"/>
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderGuardianThreshold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="0.3"
                        android:valueTo="0.95"
                        android:stepSize="0.01"
                        android:value="0.72"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Block করতে কতটা region লাগবে"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="11sp"
                        android:layout_marginBottom="8dp"/>

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupGridVote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:selectionRequired="true"
                        app:chipSpacingHorizontal="8dp">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipVote1"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="১টা (Sensitive)"/>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipVote2"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="২টা (Balanced)"
                            android:checked="true"/>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipVote3"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="৩টা (Strict)"/>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipVote4"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="৪টা (Very Strict)"/>
                    </com.google.android.material.chip.ChipGroup>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="↑ বাড়ালে কম false positive, কম detection&#10;↓ কমালে বেশি detection, বেশি false positive"
                        android:textColor="@color/on_surface_dim"
                        android:textSize="10sp"
                        android:lineSpacingMultiplier="1.2"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- AI MODELS -->
            <TextView
                style="@style/TextAppearance.GuardianShield.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_models"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface_high"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_subtle"
                app:strokeWidth="1dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Guardian Model (.tflite)"
                        android:textColor="@color/on_surface"
                        android:textSize="13sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/txtLegacyStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/model_missing"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="10dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnImportLegacy"
                            style="@style/Widget.GuardianShield.ButtonTonal"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Import • ইমপোর্ট"
                            android:layout_marginEnd="4dp"
                            app:icon="@drawable/ic_upload"
                            app:iconGravity="textStart"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRemoveLegacy"
                            style="@style/Widget.GuardianShield.ButtonTonal"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Remove • মুছুন"
                            android:layout_marginStart="4dp"
                            app:icon="@drawable/ic_delete"
                            app:iconGravity="textStart"/>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/border_subtle"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnChangePin"
                        style="@style/Widget.GuardianShield.ButtonTonal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Change PIN • পিন পরিবর্তন করুন"
                        app:icon="@drawable/ic_key"
                        app:iconGravity="textStart"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
