<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bg_main"
        app:title="@string/settings_title"
        app:titleTextColor="@color/on_surface"
        app:navigationIcon="@drawable/ic_arrow_back"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- PROTECTION -->
            <TextView
                style="@style/TextAppearance.GuardianShield.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_protection"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchKeyword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/keyword_filter"
                        android:textColor="@color/on_surface"/>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchAi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ai_detection"
                        android:textColor="@color/on_surface"
                        android:layout_marginTop="12dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ai_sensitivity"
                        android:textColor="@color/on_surface_dim"
                        android:layout_marginTop="16dp"
                        android:textSize="13sp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderThreshold"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:valueFrom="0.2"
                            android:valueTo="0.95"
                            android:stepSize="0.05"
                            android:value="0.7"/>

                        <TextView
                            android:id="@+id/txtThresholdValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.70"
                            android:textColor="@color/primary"
                            android:textSize="14sp"
                            android:minWidth="48dp"
                            android:gravity="end"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/unlock_delay"
                        android:textColor="@color/on_surface_dim"
                        android:layout_marginTop="12dp"
                        android:textSize="13sp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderDelay"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:valueFrom="5"
                            android:valueTo="120"
                            android:stepSize="5"
                            android:value="30"/>

                        <TextView
                            android:id="@+id/txtDelayValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="30s"
                            android:textColor="@color/primary"
                            android:textSize="14sp"
                            android:minWidth="48dp"
                            android:gravity="end"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- GENDER FILTER -->
            <TextView
                style="@style/TextAppearance.GuardianShield.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_gender"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupGender"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:selectionRequired="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipMale"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/chip_male"/>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipFemale"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/chip_female"/>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipNone"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/chip_none"
                            android:checked="true"/>
                    </com.google.android.material.chip.ChipGroup>

                    <TextView
                        android:id="@+id/txtGenderStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/on_surface_dim"
                        android:textSize="12sp"
                        android:layout_marginTop="8dp"
                        android:text="@string/gender_status_none"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- TEMP BLOCK DURATION — নতুন section -->
            <TextView
                style="@style/TextAppearance.GuardianShield.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_temp_block"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/temp_block_info"
                        android:textColor="@color/on_surface_dim"
                        android:textSize="13sp"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupBlockDuration"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:selectionRequired="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip15min"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="15 min"
                            android:checked="true"/>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip30min"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="30 min"/>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip60min"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1 ঘণ্টা"/>
                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- BLOCKING RULES -->
            <TextView
                style="@style/TextAppearance.GuardianShield.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_rules"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApps"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_apps"
                android:layout_marginBottom="8dp"
                app:cornerRadius="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKeywords"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_keywords"
                android:layout_marginBottom="8dp"
                app:cornerRadius="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSchedule"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_schedule"
                app:cornerRadius="12dp"/>

            <!-- AI MODELS -->
            <TextView
                style="@style/TextAppearance.GuardianShield.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_models"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/legacy_model" android:textColor="@color/on_surface" android:textStyle="bold"/>
                    <TextView android:id="@+id/txtLegacyStatus" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="@string/model_missing"
                        android:textColor="@color/on_surface_dim" android:textSize="12sp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginTop="4dp" android:layout_marginBottom="16dp">
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnImportLegacy"
                            style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="@string/import_" app:cornerRadius="10dp"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnRemoveLegacy"
                            style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_marginStart="8dp"
                            android:text="@string/remove" android:textColor="@color/error"/>
                    </LinearLayout>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/nsfw_model" android:textColor="@color/on_surface" android:textStyle="bold"/>
                    <TextView android:id="@+id/txtNsfwStatus" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="@string/model_missing"
                        android:textColor="@color/on_surface_dim" android:textSize="12sp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginTop="4dp" android:layout_marginBottom="16dp">
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnImportNsfw"
                            style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="@string/import_" app:cornerRadius="10dp"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnRemoveNsfw"
                            style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_marginStart="8dp"
                            android:text="@string/remove" android:textColor="@color/error"/>
                    </LinearLayout>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/gender_model" android:textColor="@color/on_surface" android:textStyle="bold"/>
                    <TextView android:id="@+id/txtGenderModelStatus" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="@string/model_missing"
                        android:textColor="@color/on_surface_dim" android:textSize="12sp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginTop="4dp">
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnImportGender"
                            style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="@string/import_" app:cornerRadius="10dp"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnRemoveGender"
                            style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_marginStart="8dp"
                            android:text="@string/remove" android:textColor="@color/error"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SECURITY -->
            <TextView
                style="@style/TextAppearance.GuardianShield.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_security"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChangePin"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_change_pin"
                android:layout_marginBottom="8dp"
                app:cornerRadius="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPermissions"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_permissions"
                app:cornerRadius="12dp"/>

            <View android:layout_width="match_parent" android:layout_height="40dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>