<?xml version="1.0" encoding="utf-8"?>
<!-- R5 — Private DNS Auto Mode. Matches the ONE SHIELD settings-screen
     pattern (toolbar + NestedScrollView + hero status card + sheets).
     All ids/strings are NEW — no contract changes. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bg_main"
        app:title=""
        app:titleTextColor="@color/on_surface"
        app:navigationIconTint="@color/on_surface"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="36dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="12dp"
                android:text="@string/dns_auto_title"
                android:textSize="34sp"
                style="@style/TextAppearance.GuardianShield.Display"/>

            <!-- ======== STATUS HERO ======== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.GuardianShield.Card.Beacon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/txtDnsStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/TextAppearance.GuardianShield.Title"/>

                    <TextView
                        android:id="@+id/txtDnsStatusSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        style="@style/TextAppearance.GuardianShield.BodyDim"/>

                    <TextView
                        android:id="@+id/txtDnsEngine"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        style="@style/TextAppearance.GuardianShield.BodyDim"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ======== ONE-TIME ADB SETUP BANNER (visible until granted) ======== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDnsPerm"
                style="@style/Widget.GuardianShield.Card.Amber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/dns_perm_title"
                        style="@style/TextAppearance.GuardianShield.Title"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/dns_perm_body"
                        android:textColor="@color/on_surface"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.25"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDnsShizuku"
                        style="@style/Widget.GuardianShield.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/dns_perm_shizuku_btn"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDnsCopyCmd"
                        style="@style/Widget.GuardianShield.Button.Tonal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/dns_perm_copy"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDnsPermRefresh"
                        style="@style/Widget.GuardianShield.Button.Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/dns_perm_refresh"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ======== SCHEDULE SHEET ======== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.GuardianShield.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/dns_master"
                                android:textColor="@color/on_surface"
                                android:textSize="16sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/txtDnsAutoSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                style="@style/TextAppearance.GuardianShield.BodyDim"/>
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchDnsAuto"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/dns_host_label"
                        style="@style/TextAppearance.GuardianShield.SectionHeader"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/inputHostLayout"
                        style="@style/Widget.GuardianShield.SearchBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="@string/dns_host_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputHost"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textUri"
                            android:imeOptions="actionDone"
                            android:textColor="@color/on_surface"
                            android:textSize="15sp"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.chip.ChipGroup
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipAdguardFamily"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dns_preset_adguard_family"/>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCleanbrowsing"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dns_preset_cleanbrowsing"/>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipAdguard"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dns_preset_adguard_default"/>
                    </com.google.android.material.chip.ChipGroup>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/dns_window_label"
                        style="@style/TextAppearance.GuardianShield.SectionHeader"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDnsStart"
                            style="@style/Widget.GuardianShield.Button.Tonal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDnsEnd"
                            style="@style/Widget.GuardianShield.Button.Tonal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/dns_restore_note"
                        style="@style/TextAppearance.GuardianShield.BodyDim"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDnsTestOn"
                            style="@style/Widget.GuardianShield.Button.Small"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:text="@string/dns_test_on"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDnsTestOff"
                            style="@style/Widget.GuardianShield.Button.Small"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="@string/dns_test_off"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
