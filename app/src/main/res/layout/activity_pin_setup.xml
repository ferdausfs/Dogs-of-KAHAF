<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@color/bg_main"
    android:padding="24dp">

    <FrameLayout
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_marginTop="24dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_shield_glow"
            android:alpha="0.35"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardCornerRadius="26dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/primary_container"
            app:strokeColor="@color/border_strong"
            app:strokeWidth="1dp">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_shield_on"
                app:tint="@color/primary"/>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pin_setup_title"
        android:textColor="@color/on_surface"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="20dp"/>

    <TextView
        android:id="@+id/txtPrompt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pin_enter"
        android:textColor="@color/on_surface_variant"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginTop="8dp"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="28dp">

        <View android:id="@+id/dot1" android:layout_width="14dp" android:layout_height="14dp"
            android:layout_margin="7dp" android:background="@drawable/dot_empty"/>
        <View android:id="@+id/dot2" android:layout_width="14dp" android:layout_height="14dp"
            android:layout_margin="7dp" android:background="@drawable/dot_empty"/>
        <View android:id="@+id/dot3" android:layout_width="14dp" android:layout_height="14dp"
            android:layout_margin="7dp" android:background="@drawable/dot_empty"/>
        <View android:id="@+id/dot4" android:layout_width="14dp" android:layout_height="14dp"
            android:layout_margin="7dp" android:background="@drawable/dot_empty"/>
        <View android:id="@+id/dot5" android:layout_width="14dp" android:layout_height="14dp"
            android:layout_margin="7dp" android:background="@drawable/dot_empty"/>
        <View android:id="@+id/dot6" android:layout_width="14dp" android:layout_height="14dp"
            android:layout_margin="7dp" android:background="@drawable/dot_empty"/>
    </LinearLayout>

    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="4"
        android:layout_marginTop="24dp">

        <Button android:id="@+id/btn1" style="@style/PinDigit" android:text="1"/>
        <Button android:id="@+id/btn2" style="@style/PinDigit" android:text="2"/>
        <Button android:id="@+id/btn3" style="@style/PinDigit" android:text="3"/>
        <Button android:id="@+id/btn4" style="@style/PinDigit" android:text="4"/>
        <Button android:id="@+id/btn5" style="@style/PinDigit" android:text="5"/>
        <Button android:id="@+id/btn6" style="@style/PinDigit" android:text="6"/>
        <Button android:id="@+id/btn7" style="@style/PinDigit" android:text="7"/>
        <Button android:id="@+id/btn8" style="@style/PinDigit" android:text="8"/>
        <Button android:id="@+id/btn9" style="@style/PinDigit" android:text="9"/>
        <Button android:id="@+id/btnDel" style="@style/PinDigit" android:text="⌫"/>
        <Button android:id="@+id/btn0" style="@style/PinDigit" android:text="0"/>
        <Button android:id="@+id/btnOk" style="@style/PinDigit.PremiumPrimary" android:text="✓"/>
    </GridLayout>
</LinearLayout>
