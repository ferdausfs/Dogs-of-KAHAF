<?xml version="1.0" encoding="utf-8"?>
<!-- ONE SHIELD (One UI 8, color rev r2) — Keywords list.
     Was: WATCHTOWER V3 rows-in-gaps + V3 sky-blue empty well.
     Now matches guardian-redesign/mocks/oneui8/keywords.html: Display title,
     lock banner, rows inside ONE sheet (item_keyword), designed empty state,
     accent FAB in the thumb zone.
     Bindings preserved: toolbar lockBanner txtLockRemaining txtEmpty recycler
     fabAdd. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_main"
        app:elevation="0dp">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/bg_main"
            app:title=""
            app:titleTextColor="@color/on_surface"
            app:navigationIconTint="@color/on_surface"/>
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="10dp"
            android:text="@string/keywords_title"
            android:textAppearance="@style/TextAppearance.GuardianShield.Display"/>

        <LinearLayout
            android:id="@+id/lockBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_lock_banner"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="14dp"
            android:visibility="gone"
            tools:visibility="gone">
            <ImageView
                android:layout_width="19dp" android:layout_height="19dp"
                android:src="@drawable/ic_time_lock"
                app:tint="@color/warning_amber"
                android:importantForAccessibility="no"/>
            <TextView
                android:id="@+id/txtLockRemaining"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="@color/warning_amber"
                android:textSize="13sp" android:textStyle="bold"/>
        </LinearLayout>

        <!-- Empty state (mock: inset well + dim glyph, 17sp/800 heading) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/txtEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            style="@style/Widget.GuardianShield.Card"
            tools:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center"
                android:paddingVertical="44dp" android:paddingHorizontal="30dp">
                <FrameLayout
                    android:layout_width="64dp" android:layout_height="64dp"
                    android:background="@drawable/bg_icon_well">
                    <ImageView android:layout_width="26dp" android:layout_height="26dp"
                        android:layout_gravity="center" android:src="@drawable/ic_keyword"
                        app:tint="@color/on_surface_dim" android:importantForAccessibility="no"/>
                </FrameLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:text="@string/no_keywords_heading"
                    android:textColor="@color/on_surface" android:textSize="17sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:text="@string/no_keywords"
                    android:textColor="@color/on_surface_variant" android:textSize="13.5sp"
                    android:lineSpacingMultiplier="1.5" android:gravity="center"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- rows live inside ONE sheet; the sheet takes the remaining space and
             the recycler scrolls inside it -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            style="@style/Widget.GuardianShield.Card">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingBottom="110dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                tools:itemCount="6"/>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:text="@string/add_keyword"
        android:textColor="@color/on_primary"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/on_primary"
        app:backgroundTint="@color/primary"
        app:elevation="6dp"
        app:rippleColor="@color/ripple_primary"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
