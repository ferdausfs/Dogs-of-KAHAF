<?xml version="1.0" encoding="utf-8"?>
<!-- ONE SHIELD (One UI 8, color rev r2) — Schedule rules list.
     Matches guardian-redesign/mocks/oneui8/schedule.html: rows inside ONE
     sheet, designed empty state, accent FAB.
     Bindings preserved: toolbar lockBanner txtLockRemaining txtEmpty recycler fabAdd. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_main"
        app:elevation="0dp">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/bg_main"
            app:title=""
            app:titleTextColor="@color/on_surface"
            app:navigationIconTint="@color/on_surface"/>
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="10dp"
            android:text="@string/schedule_title"
            android:textAppearance="@style/TextAppearance.GuardianShield.Display"/>

        <LinearLayout
            android:id="@+id/lockBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_lock_banner"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="14dp"
            android:visibility="gone"
            tools:visibility="gone">
            <ImageView
                android:layout_width="19dp" android:layout_height="19dp"
                android:src="@drawable/ic_time_lock"
                app:tint="@color/warning_amber"
                android:importantForAccessibility="no"/>
            <TextView
                android:id="@+id/txtLockRemaining"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="@color/warning_amber"
                android:textSize="12.5sp" android:textStyle="bold"/>
        </LinearLayout>

        <!-- R4 — Focus Mode hero (reference "Focus Mode is Active" card):
             violet beacon, countdown ring, duration chips, start/stop. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFocus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="14dp"
            style="@style/Widget.GuardianShield.Card.Beacon">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingVertical="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <LinearLayout
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/focus_title"
                            android:textColor="@color/on_primary_container"
                            android:alpha="0.72" android:textSize="11.5sp"/>
                        <TextView
                            android:id="@+id/txtFocusStatus"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/focus_status_ready"
                            android:textColor="@color/on_primary_container"
                            android:textSize="18sp" android:textStyle="bold"
                            android:letterSpacing="-0.01"/>
                        <TextView
                            android:id="@+id/txtFocusHint"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/focus_hint_ready"
                            android:textColor="@color/on_primary_container"
                            android:alpha="0.75" android:textSize="12.5sp"
                            android:lineSpacingMultiplier="1.35"/>
                    </LinearLayout>
                    <FrameLayout
                        android:layout_width="68dp" android:layout_height="68dp"
                        android:layout_marginStart="14dp">
                        <com.guardian.shield.ui.charts.FocusRingView
                            android:id="@+id/focusRing"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"/>
                        <TextView
                            android:id="@+id/txtFocusRemaining"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:textColor="@color/on_primary_container"
                            android:textSize="12.5sp" android:textStyle="bold"
                            android:fontFeatureSettings="tnum"
                            tools:text="25:00"/>
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFocus15"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:text="@string/focus_chip_15"
                        android:textAlignment="center"
                        style="@style/Widget.GuardianShield.Chip.Filter"
                        android:checkable="true"/>
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFocus25"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:text="@string/focus_chip_25"
                        android:textAlignment="center"
                        style="@style/Widget.GuardianShield.Chip.Filter"
                        android:checkable="true"/>
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFocus45"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:text="@string/focus_chip_45"
                        android:textAlignment="center"
                        style="@style/Widget.GuardianShield.Chip.Filter"
                        android:checkable="true"/>
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFocus60"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/focus_chip_60"
                        android:textAlignment="center"
                        style="@style/Widget.GuardianShield.Chip.Filter"
                        android:checkable="true"/>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFocusToggle"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="14dp"
                    android:text="@string/focus_start"
                    style="@style/Widget.GuardianShield.Button.Tonal"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ======== R7.5 BEDTIME MODE (nightly scheduled focus) ======== -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.GuardianShield.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingVertical="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/bedtime_title"
                            android:textColor="@color/on_surface"
                            android:textSize="17sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/bedtime_sub"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="12.5sp"/>
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchBedtime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/txtBedtimeStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="12.5sp"
                    android:fontFeatureSettings="tnum"/>

                <LinearLayout
                    android:id="@+id/rowBedtimeTimes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBedtimeStart"
                        style="@style/Widget.GuardianShield.Button.Tonal"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBedtimeEnd"
                        style="@style/Widget.GuardianShield.Button.Tonal"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/txtEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            style="@style/Widget.GuardianShield.Card"
            tools:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center"
                android:paddingVertical="44dp" android:paddingHorizontal="30dp">
                <FrameLayout
                    android:layout_width="64dp" android:layout_height="64dp"
                    android:background="@drawable/bg_icon_well">
                    <ImageView android:layout_width="26dp" android:layout_height="26dp"
                        android:layout_gravity="center" android:src="@drawable/ic_clock"
                        app:tint="@color/on_surface_dim" android:importantForAccessibility="no"/>
                </FrameLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:text="@string/no_schedules_heading"
                    android:textColor="@color/on_surface" android:textSize="17sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:text="@string/no_schedules"
                    android:textColor="@color/on_surface_variant" android:textSize="13.5sp"
                    android:lineSpacingMultiplier="1.5" android:gravity="center"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            style="@style/Widget.GuardianShield.Card">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingBottom="110dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                tools:itemCount="4"/>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:text="@string/add_schedule"
        android:textColor="@color/on_primary"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/on_primary"
        app:backgroundTint="@color/primary"
        app:elevation="6dp"
        app:rippleColor="@color/ripple_primary"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
