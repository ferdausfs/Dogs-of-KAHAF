<?xml version="1.0" encoding="utf-8"?>
<!-- WATCHTOWER V3 — Strike-3 full block overlay (approved: mocks/v3/overlays.html frame B)
     Bindings preserved: txtPackage cardTempBlock txtTempBanner txtReason
     txtCategory btnHome btnUnlock btnMarkFalse.
     btnHome -> goHome(), btnUnlock -> DelayUnlockActivity, btnMarkFalse ->
     FalsePositiveMemory — behavior untouched. -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none"
    android:background="@color/overlay_dim_solid">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="30dp">

        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="0.55"/>

        <!-- Hero halo -->
        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/bg_halo_red">
            <ImageView
                android:layout_width="42dp" android:layout_height="42dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_shield_alert"
                app:tint="@color/error"
                android:importantForAccessibility="no"/>
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/overlay_access_blocked"
            android:textColor="@color/on_surface"
            android:textSize="24sp" android:textStyle="bold" android:letterSpacing="-0.015"
            android:gravity="center"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxWidth="300dp"
            android:text="@string/overlay_sensitive_subtitle"
            android:textColor="@color/on_surface_variant"
            android:textSize="13.5sp" android:lineSpacingMultiplier="1.45"
            android:gravity="center"/>

        <!-- package pill -->
        <TextView
            android:id="@+id/txtPackage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_badge"
            android:backgroundTint="@color/badge_neutral_bg"
            android:fontFamily="monospace"
            android:textColor="@color/on_surface_variant"
            android:textSize="11sp"
            android:paddingHorizontal="14dp" android:paddingVertical="6dp"
            tools:text="com.instagram.android"/>

        <!-- temp-block banner (temp-block case only) -->
        <LinearLayout
            android:id="@+id/cardTempBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_lock_banner"
            android:paddingHorizontal="14dp" android:paddingVertical="12dp"
            android:layout_marginTop="18dp"
            android:visibility="gone"
            tools:visibility="visible">
            <ImageView
                android:layout_width="18dp" android:layout_height="18dp"
                android:src="@drawable/ic_time_lock"
                app:tint="@color/warning_amber"
                android:importantForAccessibility="no"/>
            <TextView
                android:id="@+id/txtTempBanner"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="@color/on_warning_container"
                android:textSize="12.5sp" android:textStyle="bold"
                tools:text="🚫 Blocked for 15 minutes"/>
        </LinearLayout>

        <!-- info grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">
            <LinearLayout
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_stat_card"
                android:padding="12dp"
                android:layout_marginEnd="5dp">
                <FrameLayout
                    android:layout_width="34dp" android:layout_height="34dp"
                    android:background="@drawable/bg_icon_well"
                    android:backgroundTint="@color/badge_success_bg">
                    <ImageView android:layout_width="17dp" android:layout_height="17dp"
                        android:layout_gravity="center" android:src="@drawable/ic_shield_check"
                        app:tint="@color/success" android:importantForAccessibility="no"/>
                </FrameLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:text="@string/overlay_protection"
                    android:textColor="@color/on_surface_dim" android:textSize="9.5sp"
                    android:textStyle="bold" android:letterSpacing="0.1" android:textAllCaps="true"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" android:text="@string/overlay_protection_active"
                    android:textColor="@color/success" android:textSize="13sp" android:textStyle="bold"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_stat_card"
                android:padding="12dp"
                android:layout_marginHorizontal="5dp">
                <FrameLayout
                    android:layout_width="34dp" android:layout_height="34dp"
                    android:background="@drawable/bg_icon_well"
                    android:backgroundTint="@color/badge_ai_bg">
                    <ImageView android:layout_width="17dp" android:layout_height="17dp"
                        android:layout_gravity="center" android:src="@drawable/ic_ai_spark"
                        app:tint="@color/ai_accent" android:importantForAccessibility="no"/>
                </FrameLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:text="@string/overlay_blocked_category"
                    android:textColor="@color/on_surface_dim" android:textSize="9.5sp"
                    android:textStyle="bold" android:letterSpacing="0.1" android:textAllCaps="true"/>
                <TextView
                    android:id="@+id/txtCategory"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/ai_accent" android:textSize="13sp" android:textStyle="bold"
                    tools:text="AI Detection"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_stat_card"
                android:padding="12dp"
                android:layout_marginStart="5dp">
                <FrameLayout
                    android:layout_width="34dp" android:layout_height="34dp"
                    android:background="@drawable/bg_icon_well"
                    android:backgroundTint="@color/badge_neutral_bg">
                    <ImageView android:layout_width="17dp" android:layout_height="17dp"
                        android:layout_gravity="center" android:src="@drawable/ic_clock"
                        app:tint="@color/on_surface_variant" android:importantForAccessibility="no"/>
                </FrameLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:text="@string/overlay_time"
                    android:textColor="@color/on_surface_dim" android:textSize="9.5sp"
                    android:textStyle="bold" android:letterSpacing="0.1" android:textAllCaps="true"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" android:text="@string/overlay_time_now"
                    android:textColor="@color/on_surface" android:textSize="13sp" android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

        <!-- reason -->
        <TextView
            android:id="@+id/txtReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_stat_card"
            android:padding="13dp"
            android:gravity="center"
            android:textColor="@color/warning_amber"
            android:textSize="13sp" android:textStyle="bold"
            android:lineSpacingMultiplier="1.35"
            tools:text="AI ক্ষতিকারক বা অশ্লীল কন্টেন্ট খুঁজে পেয়েছে"/>

        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="0.45"/>

        <!-- actions -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHome"
            style="@style/Widget.GuardianShield.Button.Danger"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="22dp"
            app:icon="@drawable/ic_home"
            app:iconTint="@color/on_error"
            android:text="@string/overlay_go_home"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUnlock"
            style="@style/Widget.GuardianShield.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:text="@string/overlay_request_unlock"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMarkFalse"
            style="@style/Widget.GuardianShield.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="@string/overlay_mark_false"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="18dp">
            <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp"
                android:background="@color/border_subtle"/>
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:text="@string/overlay_motivation"
                android:textColor="@color/on_surface_dim"
                android:textSize="9.5sp" android:textStyle="bold" android:letterSpacing="0.16"/>
            <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp"
                android:background="@color/border_subtle"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
