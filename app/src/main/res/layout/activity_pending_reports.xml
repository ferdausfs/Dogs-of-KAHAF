<?xml version="1.0" encoding="utf-8"?>
<!-- TASK B — Pending reports screen. Minimal list of cooling-off queue entries
     with cancel buttons. Matches the app's One UI 8 design tokens. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bg_main"
        app:title="@string/pending_reports_title"
        app:titleTextColor="@color/on_surface"
        app:navigationIconTint="@color/on_surface"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingBottom="8dp"
        android:text="@string/pending_reports_subtitle"
        android:textColor="@color/on_surface_variant"
        android:textSize="13sp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerPending"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="16dp"
        android:clipToPadding="false"/>

    <TextView
        android:id="@+id/txtEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/pending_reports_empty"
        android:textColor="@color/on_surface_dim"
        android:textSize="15sp"
        android:visibility="gone"
        tools:visibility="visible"/>
</LinearLayout>
