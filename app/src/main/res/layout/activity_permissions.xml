<?xml version="1.0" encoding="utf-8"?>
<!-- ONE SHIELD (One UI 8, color rev r2) — Permission Health
     (mocks/oneui8/permissions.html): five rows in ONE sheet, inline 20dp
     glyph, GRANTED badge / FIX tonal pill, bottom-weighted Fix All.
     Bindings preserved: toolbar rowAccessibility iconAccessibility btnAccessibility
     rowUsageStats iconUsageStats btnUsageStats rowOverlay iconOverlay btnOverlay
     rowNotification iconNotification btnNotification rowBattery iconBattery
     btnBattery btnFixAll (icon/btn classes unchanged — code swaps state icons/colors). -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bg_main"
        app:title=""
        app:titleTextColor="@color/on_surface"
        app:navigationIconTint="@color/on_surface"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="12dp"
                android:text="@string/permissions_title"
                android:textSize="34sp"
                style="@style/TextAppearance.GuardianShield.Display"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.GuardianShield.Card">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <!-- Accessibility -->
                    <LinearLayout
                        android:id="@+id/rowAccessibility"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="14dp"
                        android:minHeight="64dp"
                        android:background="?attr/selectableItemBackground">
                        <ImageView
                                android:id="@+id/iconAccessibility"
                                android:layout_width="20dp" android:layout_height="20dp"
                                android:src="@drawable/ic_access"
                                app:tint="@color/primary_dim"
                                android:importantForAccessibility="no"/>
                        <LinearLayout
                            android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:orientation="vertical"
                            android:layout_marginStart="16dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/perm_accessibility" android:textColor="@color/on_surface"
                                android:textSize="16sp" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="2dp" android:text="@string/perm_accessibility_sub"
                                android:textColor="@color/on_surface_variant" android:textSize="13sp"/>
                        </LinearLayout>
                        <TextView
                            android:id="@+id/btnAccessibility"
                            android:layout_width="wrap_content" android:layout_height="36dp"
                            android:gravity="center"
                            android:background="@drawable/bg_badge"
                            android:backgroundTint="@color/badge_neutral_bg"
                            android:paddingHorizontal="16dp"
                            android:textSize="12sp" android:textStyle="bold"
                            android:letterSpacing="0.04"
                            tools:text="FIX"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginHorizontal="16dp" android:background="@color/border_subtle"/>

                    <!-- Usage stats -->
                    <LinearLayout
                        android:id="@+id/rowUsageStats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="14dp"
                        android:minHeight="64dp"
                        android:background="?attr/selectableItemBackground">
                        <ImageView
                                android:id="@+id/iconUsageStats"
                                android:layout_width="20dp" android:layout_height="20dp"
                                android:src="@drawable/ic_usage"
                                app:tint="@color/primary_dim"
                                android:importantForAccessibility="no"/>
                        <LinearLayout
                            android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:orientation="vertical"
                            android:layout_marginStart="16dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/perm_usage_stats" android:textColor="@color/on_surface"
                                android:textSize="16sp" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="2dp" android:text="@string/perm_usage_sub"
                                android:textColor="@color/on_surface_variant" android:textSize="13sp"/>
                        </LinearLayout>
                        <TextView
                            android:id="@+id/btnUsageStats"
                            android:layout_width="wrap_content" android:layout_height="36dp"
                            android:gravity="center"
                            android:background="@drawable/bg_badge"
                            android:backgroundTint="@color/badge_neutral_bg"
                            android:paddingHorizontal="16dp"
                            android:textSize="12sp" android:textStyle="bold"
                            android:letterSpacing="0.04"
                            tools:text="FIX"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginHorizontal="16dp" android:background="@color/border_subtle"/>

                    <!-- Overlay -->
                    <LinearLayout
                        android:id="@+id/rowOverlay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="14dp"
                        android:minHeight="64dp"
                        android:background="?attr/selectableItemBackground">
                        <ImageView
                                android:id="@+id/iconOverlay"
                                android:layout_width="20dp" android:layout_height="20dp"
                                android:src="@drawable/ic_layers"
                                app:tint="@color/primary_dim"
                                android:importantForAccessibility="no"/>
                        <LinearLayout
                            android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:orientation="vertical"
                            android:layout_marginStart="16dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/perm_overlay" android:textColor="@color/on_surface"
                                android:textSize="16sp" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="2dp" android:text="@string/perm_overlay_sub"
                                android:textColor="@color/on_surface_variant" android:textSize="13sp"/>
                        </LinearLayout>
                        <TextView
                            android:id="@+id/btnOverlay"
                            android:layout_width="wrap_content" android:layout_height="36dp"
                            android:gravity="center"
                            android:background="@drawable/bg_badge"
                            android:backgroundTint="@color/badge_neutral_bg"
                            android:paddingHorizontal="16dp"
                            android:textSize="12sp" android:textStyle="bold"
                            android:letterSpacing="0.04"
                            tools:text="FIX"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginHorizontal="16dp" android:background="@color/border_subtle"/>

                    <!-- Notification -->
                    <LinearLayout
                        android:id="@+id/rowNotification"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="14dp"
                        android:minHeight="64dp"
                        android:background="?attr/selectableItemBackground">
                        <ImageView
                                android:id="@+id/iconNotification"
                                android:layout_width="20dp" android:layout_height="20dp"
                                android:src="@drawable/ic_bell"
                                app:tint="@color/primary_dim"
                                android:importantForAccessibility="no"/>
                        <LinearLayout
                            android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:orientation="vertical"
                            android:layout_marginStart="16dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/perm_notification" android:textColor="@color/on_surface"
                                android:textSize="16sp" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="2dp" android:text="@string/perm_notification_sub"
                                android:textColor="@color/on_surface_variant" android:textSize="13sp"/>
                        </LinearLayout>
                        <TextView
                            android:id="@+id/btnNotification"
                            android:layout_width="wrap_content" android:layout_height="36dp"
                            android:gravity="center"
                            android:background="@drawable/bg_badge"
                            android:backgroundTint="@color/badge_neutral_bg"
                            android:paddingHorizontal="16dp"
                            android:textSize="12sp" android:textStyle="bold"
                            android:letterSpacing="0.04"
                            tools:text="FIX"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginHorizontal="16dp" android:background="@color/border_subtle"/>

                    <!-- Battery -->
                    <LinearLayout
                        android:id="@+id/rowBattery"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="14dp"
                        android:minHeight="64dp"
                        android:background="?attr/selectableItemBackground">
                        <ImageView
                                android:id="@+id/iconBattery"
                                android:layout_width="20dp" android:layout_height="20dp"
                                android:src="@drawable/ic_battery"
                                app:tint="@color/primary_dim"
                                android:importantForAccessibility="no"/>
                        <LinearLayout
                            android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:orientation="vertical"
                            android:layout_marginStart="16dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/perm_battery" android:textColor="@color/on_surface"
                                android:textSize="16sp" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="2dp" android:text="@string/perm_battery_sub"
                                android:textColor="@color/on_surface_variant" android:textSize="13sp"/>
                        </LinearLayout>
                        <TextView
                            android:id="@+id/btnBattery"
                            android:layout_width="wrap_content" android:layout_height="36dp"
                            android:gravity="center"
                            android:background="@drawable/bg_badge"
                            android:backgroundTint="@color/badge_neutral_bg"
                            android:paddingHorizontal="16dp"
                            android:textSize="12sp" android:textStyle="bold"
                            android:letterSpacing="0.04"
                            tools:text="FIX"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFixAll"
                style="@style/Widget.GuardianShield.Button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                app:icon="@drawable/ic_wrench"
                app:iconTint="@color/on_primary"
                android:text="@string/fix_all"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
