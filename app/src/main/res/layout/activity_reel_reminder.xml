<?xml version="1.0" encoding="utf-8"?>
<!-- WATCHTOWER V3 — Reel reminder (Islamic interstitial). Real copy kept verbatim.
     Bindings preserved: imgIslamic txtTitle txtHadith txtSubtitle btnOpenQuran btnContinue. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingHorizontal="26dp"
    android:background="@color/bg_main">

    <TextView
        android:id="@+id/imgIslamic"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="52sp"/>

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:textColor="@color/on_surface"
        android:textSize="21sp" android:textStyle="bold" android:letterSpacing="-0.015"/>

    <TextView
        android:id="@+id/txtHadith"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:maxWidth="310dp"
        android:text="@string/reel_hadith"
        android:textColor="@color/on_surface_variant"
        android:textSize="13sp" android:lineSpacingMultiplier="1.7"
        android:textStyle="italic"
        android:gravity="center"/>

    <TextView
        android:id="@+id/txtSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:maxWidth="310dp"
        android:textColor="@color/on_surface_variant"
        android:textSize="12.5sp" android:lineSpacingMultiplier="1.6"
        android:gravity="center"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOpenQuran"
        style="@style/Widget.GuardianShield.Button"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="30dp"
        app:icon="@drawable/ic_quran"
        app:iconTint="@color/on_primary"
        android:text="@string/reel_open_quran"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnContinue"
        style="@style/Widget.GuardianShield.Button.Text"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="@string/reel_continue"/>
</LinearLayout>
