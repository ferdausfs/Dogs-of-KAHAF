<?xml version="1.0" encoding="utf-8"?>
<!-- WATCHTOWER V3 — Strike 1/2 warning card (WindowManager TYPE_APPLICATION_OVERLAY).
     Approved mockup: guardian-redesign/mocks/v3/overlays.html frame A
     RE-SKIN ONLY — behavior contract untouched:
       • auto-dismiss after STRIKE_WARNING_AUTO_DISMISS_MS = 3_500L (code)
       • tap card to dismiss; separate click target for btnNotSensitive
       • "Not sensitive" writes an audit-only DB row (never touches detection)
     Tokens: surface_highest card, warning stroke, ringed leading icon,
     kicker/title/body scale per V3 type ramp. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardStrikeWarning"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/surface_highest"
    app:cardCornerRadius="24dp"
    app:cardElevation="16dp"
    app:strokeColor="@color/warning_container"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="16dp">

        <!-- ringed leading icon (decorative ring echoes the 3.5s dismiss timer) -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_strike_warning_icon">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:contentDescription="@null"
                android:src="@drawable/ic_shield_alert"
                app:tint="@color/warning"/>
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtStrikeKicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_strike_warning_kicker"
                android:textColor="@color/warning"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.14"/>

            <TextView
                android:id="@+id/txtStrikeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/on_surface"
                android:textSize="17sp"
                android:textStyle="bold"
                android:letterSpacing="-0.01"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/txtStrikeBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_strike_warning_body"
                android:textColor="@color/on_surface_variant"
                android:textSize="12.5sp"
                android:lineSpacingMultiplier="1.4"
                android:layout_marginTop="5dp"/>

            <!-- v2.5.4 "Not sensitive" audit report action — own click target,
                 handler + Toast + explicit dismiss preserved in code. -->
            <TextView
                android:id="@+id/btnNotSensitive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="30dp"
                android:gravity="center_vertical"
                android:paddingVertical="3dp"
                android:text="@string/ai_strike_warning_not_sensitive"
                android:textColor="@color/on_surface_variant"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:background="@null"
                android:contentDescription="@string/ai_strike_warning_not_sensitive"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
