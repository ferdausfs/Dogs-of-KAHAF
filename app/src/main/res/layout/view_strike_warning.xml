<?xml version="1.0" encoding="utf-8"?>
<!-- v2.5.2 — Strike 1/2 warning card (WindowManager TYPE_APPLICATION_OVERLAY).
     Re-skinned to the Sentinel design language. Behavior preserved:
     width = screen - 40dp, Gravity TOP|CENTER_HORIZONTAL, y = 18% height,
     tap-to-dismiss, 3.5s auto-dismiss, audit-only "Not sensitive" report. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardStrikeWarning"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/surface_variant"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/warning"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_badge"
            android:backgroundTint="@color/warning_container">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:contentDescription="@null"
                android:src="@drawable/ic_warning"
                app:tint="@color/warning"/>
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtStrikeKicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_strike_warning_kicker"
                android:textColor="@color/warning"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.12"/>

            <TextView
                android:id="@+id/txtStrikeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/on_surface"
                android:textSize="16.5sp"
                android:textStyle="bold"
                android:letterSpacing="-0.01"
                android:layout_marginTop="2dp"/>

            <TextView
                android:id="@+id/txtStrikeBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_strike_warning_body"
                android:textColor="@color/on_surface_variant"
                android:textSize="12.5sp"
                android:lineSpacingMultiplier="1.35"
                android:layout_marginTop="3dp"/>

            <!-- v2.5.4 — "Not sensitive" audit report. Own click target so the
                 card's tap-to-dismiss listener is NOT fired. Writes a
                 NOT_SENSITIVE audit event only — never touches
                 FalsePositiveMemory / AiDetector. -->
            <TextView
                android:id="@+id/btnNotSensitive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="28dp"
                android:gravity="center_vertical"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="@string/ai_strike_warning_not_sensitive"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:background="@null"
                android:contentDescription="@string/ai_strike_warning_not_sensitive"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
