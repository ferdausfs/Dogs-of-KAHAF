<?xml version="1.0" encoding="utf-8"?>
<!-- v2.5.2 — Strike 1/2 warning card (WindowManager TYPE_APPLICATION_OVERLAY).
     Approved mockup: guardian-redesign/mocks/strike-warning-card.html
     All tokens from the merged v2.5.0 design system:
       surface      : @color/surface_high            (#1C232E, lifts off bg_main)
       border       : 1.5dp @color/warning          (#FBBF24 warning accent)
       radius       : 20dp (r-md, ShapeAppearance.Medium / CardPremium)
       icon         : ic_shield_large tinted @color/warning in 44dp surface_variant circle
       title        : bold, @color/on_surface  (#E2E6EB)
       kicker/body  : SectionHeader caps / on_surface_variant (#A3ADBB)
     No dog/mascot icon. Strike-3 BlockOverlayActivity path is untouched. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardStrikeWarning"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/surface_high"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/warning"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_strike_warning_icon">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:contentDescription="@null"
                android:src="@drawable/ic_shield_large"
                app:tint="@color/warning"/>
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtStrikeKicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_strike_warning_kicker"
                android:textColor="@color/warning"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.06"/>

            <TextView
                android:id="@+id/txtStrikeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/on_surface"
                android:textSize="16.5sp"
                android:textStyle="bold"
                android:letterSpacing="-0.01"
                android:layout_marginTop="2dp"/>

            <TextView
                android:id="@+id/txtStrikeBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_strike_warning_body"
                android:textColor="@color/on_surface_variant"
                android:textSize="12.5sp"
                android:lineSpacingMultiplier="1.35"
                android:layout_marginTop="3dp"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
