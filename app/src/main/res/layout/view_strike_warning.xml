<?xml version="1.0" encoding="utf-8"?>
<!-- ONE SHIELD (One UI 8, color rev r2) — Strike 1/2 warning card
     (WindowManager TYPE_APPLICATION_OVERLAY).

     v3.3.0: rotating Qur'anic ayat + Bengali translation, compact
     "আমি বুঝেছি" acknowledge, user-driven dismiss (no 3.5s auto-dismiss).

     v3.6.0: three-button layout — primary "আমি বুঝেছি" (row 1) + two
     opposite-intent secondary actions side by side (row 2):
       • "সংবেদনশীল নয়" (btnNotSensitive, flag icon) — existing behavior
         (confidence-based cooling-off report path, unchanged).
       • "সংরক্ষণ করো" (btnProtect, shield icon) — NEW: permanently saves the
         current pattern into ConfirmedSensitiveMemory (protect flow).

     Bindings (ids/types that existing code already finds):
       cardStrikeWarning txtStrikeKicker txtStrikeTitle txtStrikeBody
       btnNotSensitive btnAcknowledge
     New:
       txtAyatArabic txtAyatBengali txtAyatCitation
       txtAyatReminder btnProtect -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardStrikeWarning"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/surface_highest"
    app:cardCornerRadius="24dp"
    app:cardElevation="16dp"
    app:strokeColor="@color/glow_warning"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="16dp">

        <!-- Header: 44dp warning-container icon well + title/body -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_icon_well"
                android:backgroundTint="@color/warning_container">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_shield_alert"
                    app:tint="@color/warning_amber"/>
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtStrikeKicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_strike_warning_kicker"
                    android:textColor="@color/warning_amber"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.12"/>

                <TextView
                    android:id="@+id/txtStrikeTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/on_surface"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.01"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:id="@+id/txtStrikeBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_strike_warning_body"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="12.5sp"
                    android:lineSpacingMultiplier="1.4"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- TASK A — AI confidence badge (e.g. "AI • 0.87") -->
            <TextView
                android:id="@+id/txtConfidenceBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge"
                android:backgroundTint="@color/badge_ai_bg"
                android:textColor="@color/ai_accent"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:visibility="gone"
                tools:text="AI • 0.87"
                tools:visibility="visible"/>
        </LinearLayout>

        <!-- Ayat block: Arabic (RTL) + Bengali (LTR) + citation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="14dp">
            <include layout="@layout/include_ayat_block"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/border_subtle"/>

        <TextView
            android:id="@+id/txtAyatReminder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/ai_strike_ayat_reminder"
            android:textColor="@color/on_surface_variant"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:lineSpacingMultiplier="1.35"/>

        <!-- Actions: compact primary acknowledge (row 1) + two secondary
             opposite-intent actions side by side (row 2).
             v3.6.0: btnNotSensitive ("সংবেদনশীল নয়", flag/report icon) and
             btnProtect ("সংরক্ষণ করো", shield icon) are visually distinct so
             their opposite intents cannot be confused:
               • btnNotSensitive = warning-amber flag → reports the block as
                 wrong (may whitelist via the confidence-based cooling-off).
               • btnProtect = success-green shield → saves the pattern as
                 PERMANENTLY confirmed-sensitive (the opposite memory). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAcknowledge"
                style="@style/Widget.GuardianShield.Button.Compact"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:text="@string/ai_strike_acknowledge"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/btnNotSensitive"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:gravity="center"
                android:paddingVertical="4dp"
                android:drawableStart="@drawable/ic_flag"
                android:drawablePadding="6dp"
                android:drawableTint="@color/warning_amber"
                android:text="@string/ai_strike_warning_not_sensitive"
                android:textColor="@color/on_surface_variant"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:background="@null"
                android:contentDescription="@string/ai_strike_warning_not_sensitive"/>

            <TextView
                android:id="@+id/btnProtect"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:gravity="center"
                android:paddingVertical="4dp"
                android:drawableStart="@drawable/ic_shield_check"
                android:drawablePadding="6dp"
                android:drawableTint="@color/success_legacy"
                android:text="@string/ai_strike_protect"
                android:textColor="@color/success_legacy"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:background="@null"
                android:contentDescription="@string/ai_strike_protect"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
