<?xml version="1.0" encoding="utf-8"?>
<!-- ONE SHIELD (One UI 8, color rev r2) — Delay Unlock countdown.
     Was: WATCHTOWER V3 (amber halo + 56sp counter).
     Now matches guardian-redesign/mocks/oneui8/overlays.html frame D:
     quiet label, package pill, 72sp/800 tabular countdown, seconds caption,
     bottom-weighted tonal cancel.
     Bindings preserved: txtPackage txtCountdown btnCancel (countdown logic in
     DelayUnlockActivity.kt untouched — timing comes from prefs). -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingHorizontal="26dp"
    android:background="@color/overlay_dim_solid">

    <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="0.35"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/delay_text"
        android:textColor="@color/on_surface_variant"
        android:textSize="15sp"/>

    <TextView
        android:id="@+id/txtPackage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_badge"
        android:backgroundTint="@color/badge_neutral_bg"
        android:fontFamily="monospace"
        android:textColor="@color/on_surface_variant"
        android:textSize="11sp"
        android:paddingHorizontal="12dp" android:paddingVertical="6dp"
        tools:text="com.instagram.android"/>

    <TextView
        android:id="@+id/txtCountdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:textColor="@color/on_surface"
        android:textSize="72sp" android:textStyle="bold" android:letterSpacing="-0.04"
        android:fontFeatureSettings="tnum"
        tools:text="29"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/seconds"
        android:textColor="@color/on_surface_dim"
        android:textSize="13sp"/>

    <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="0.35"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancel"
        style="@style/Widget.GuardianShield.Button.Tonal"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="30dp"
        android:text="@string/cancel"/>
</LinearLayout>
