<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">
    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_lock"
        android:background="@drawable/bg_pin_dot"
        android:padding="20dp"
        android:contentDescription="Timer" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/delay_unlock_title"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:textStyle="bold" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:text="@string/delay_unlock_message"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />
    <TextView
        android:id="@+id/tvCountdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:textColor="@color/warning_orange"
        android:textSize="64sp"
        android:textStyle="bold" />
    <ProgressBar
        android:id="@+id/progressCountdown"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="24dp"
        android:max="100"
        android:progress="100"
        android:progressTint="@color/warning_orange"
        android:progressBackgroundTint="@color/divider" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnProceed"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:enabled="false"
        android:text="@string/proceed"
        android:textSize="16sp" />
</LinearLayout>
