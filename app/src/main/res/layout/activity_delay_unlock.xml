<?xml version="1.0" encoding="utf-8"?>
<!-- WATCHTOWER V3 — Delay Unlock (approved: mocks/v3/overlays.html frame D)
     Bindings preserved: txtPackage txtCountdown btnCancel (countdown logic untouched). -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingHorizontal="26dp"
    android:background="@color/overlay_dim_solid">

    <FrameLayout
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:background="@drawable/bg_halo_amber">
        <ImageView
            android:layout_width="30dp" android:layout_height="30dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_time_lock"
            app:tint="@color/warning_amber"
            android:importantForAccessibility="no"/>
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/delay_title"
        android:textColor="@color/on_surface"
        android:textSize="19sp" android:textStyle="bold" android:letterSpacing="-0.01"/>

    <TextView
        android:id="@+id/txtPackage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_badge"
        android:backgroundTint="@color/badge_neutral_bg"
        android:fontFamily="monospace"
        android:textColor="@color/on_surface_variant"
        android:textSize="11sp"
        android:paddingHorizontal="12dp" android:paddingVertical="5dp"
        tools:text="com.instagram.android"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/delay_text"
        android:textColor="@color/on_surface_variant"
        android:textSize="12.5sp"/>

    <TextView
        android:id="@+id/txtCountdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/on_surface"
        android:textSize="56sp" android:textStyle="bold" android:letterSpacing="-0.03"
        android:fontFeatureSettings="tnum"
        tools:text="00:29"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/seconds"
        android:textColor="@color/on_surface_dim"
        android:textSize="12sp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancel"
        style="@style/Widget.GuardianShield.Button.Tonal"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="28dp"
        android:text="@string/cancel"/>
</LinearLayout>
