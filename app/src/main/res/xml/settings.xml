<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory android:title="Protection Rules">
        <SwitchPreferenceCompat
            android:key="ai_enabled"
            android:title="🤖 AI Detection (3 strikes / 24h)"
            android:summary="3 strikes → automatic 24-hour block"
            android:defaultValue="true" />
        <SwitchPreferenceCompat
            android:key="scroll_enabled"
            android:title="📖 Scroll Reminder"
            android:summary="Show Quran/Hadith when binge-scrolling reels"
            android:defaultValue="true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Scroll Reminder Settings">
        <SeekBarPreference
            android:key="scroll_threshold"
            android:title="Threshold (swipes per minute)"
            android:max="30"
            android:defaultValue="15" />
        <SeekBarPreference
            android:key="scroll_cooldown_min"
            android:title="Cooldown (minutes)"
            android:max="30"
            android:defaultValue="5" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Privacy &amp; Security">
        <SwitchPreferenceCompat
            android:key="stealth_mode"
            android:title="Stealth (hide launcher icon)"
            android:summary="Open via dial code *#*#9999#*#*"
            android:defaultValue="false" />
    </PreferenceCategory>

    <PreferenceCategory android:title="About">
        <Preference
            android:title="Version"
            android:summary="2.0.0" />
    </PreferenceCategory>
</PreferenceScreen>
