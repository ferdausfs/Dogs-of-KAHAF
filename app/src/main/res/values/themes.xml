<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GuardianShield" parent="Theme.Material3.Dark">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorBackground">@color/bg_main</item>
        <item name="colorOnBackground">@color/on_surface</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorError">@color/error</item>
        <item name="android:windowBackground">@color/bg_main</item>
        <item name="android:statusBarColor">@color/bg_main</item>
        <item name="android:navigationBarColor">@color/bg_main</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fontFamily">sans-serif</item>

        <!-- Toolbar -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.GuardianShield.Dialog</item>
    </style>
      <!-- themes.xml এ add করো -->
    <style name="TextAppearance.GuardianShield.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
    <item name="android:textSize">16sp</item>
    <item name="android:textStyle">bold</item>
    <item name="android:letterSpacing">0.08</item>
    <item name="android:textColor">@color/on_surface</item>
    <item name="android:fontFamily">sans-serif-condensed</item>
    </style>
    <style name="ThemeOverlay.GuardianShield.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/surface_elevated</item>
        <item name="colorOnSurface">@color/on_surface</item>
    </style>

    <!-- Section header text style -->
    <style name="TextAppearance.GuardianShield.SectionHeader" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/on_surface_muted</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Stat number style -->
    <style name="TextAppearance.GuardianShield.StatNumber">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>
</resources>