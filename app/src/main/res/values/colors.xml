<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ================================================================
         Guardian Shield — "Sentinel" Design Language (2026-08-17)
         Light-on-dark. Green-graphite obsidian canvas + one phosphor-emerald
         signal color (green = "protected / all-clear"). Amber = warning,
         red = blocked/error, violet = AI, blue = info.
         App name "Guardian Shield" kept. Shield mark refined, not replaced.
         Full rationale + computed WCAG ratios: guardian-redesign/design-tokens.html
         ================================================================ -->

    <!-- Canvas -->
    <color name="bg_main">#0B0F0D</color>          <!-- window / scrim background -->
    <color name="bg_elevated">#101612</color>      <!-- app bar / bottom nav -->

    <!-- Surface layers (elevation steps) -->
    <color name="surface">#121915</color>         <!-- s1 — tab wells, nested regions -->
    <color name="surface_high">#161F1A</color>    <!-- s2 — standard cards -->
    <color name="surface_variant">#1C2721</color> <!-- s3 — elevated cards / inputs / tonal -->
    <color name="surface_highest">#232F29</color> <!-- s4 — hover / pressed / highest -->

    <!-- Text -->
    <color name="on_surface">#E9F1EC</color>
    <color name="on_surface_variant">#A7B9AE</color>
    <color name="on_surface_dim">#80918A</color>

    <!-- Brand accent -->
    <color name="primary">#3BE39A</color>
    <color name="on_primary">#04231A</color>
    <color name="primary_container">#123B2C</color>
    <color name="primary_container_start">#1B4A38</color> <!-- gradient light step -->
    <color name="primary_container_end">#0E2A1F</color>   <!-- gradient end -->
    <color name="on_primary_container">#B9F7DA</color>
    <color name="primary_dim">#9BEEC6</color>            <!-- muted primary (pressed fills) -->

    <color name="secondary">#A7B9AE</color>
    <color name="on_secondary">#0E2A1F</color>
    <color name="secondary_container">#161F1A</color>
    <color name="on_secondary_container">#E9F1EC</color>

    <!-- Semantic -->
    <color name="error">#FF8F86</color>
    <color name="on_error">#2B0B08</color>
    <color name="error_container">#3A1E1C</color>

    <color name="success">#5CF0AC</color>
    <color name="success_legacy">#B9F7DA</color>
    <color name="success_container">#0E2B1E</color>

    <color name="info">#7CC4FF</color>
    <color name="info_container">#12283A</color>

    <color name="warning">#FFC94D</color>
    <color name="warning_amber">#FFC94D</color>
    <color name="warning_container">#2A2210</color>

    <color name="ai_detection_color">#B79BFF</color>
    <color name="ai_accent">#B79BFF</color>
    <color name="purple">#B79BFF</color>

    <!-- Neutrals -->
    <color name="black">#000000</color>
    <color name="white">#FFFFFF</color>
    <color name="transparent">#00000000</color>
    <color name="overlay_dim">#E60B0F0D</color>       <!-- scrim over content -->
    <color name="overlay_dim_solid">#0B0F0D</color>

    <!-- Ripples / strokes -->
    <color name="ripple_primary">#203BE39A</color>
    <color name="ripple_error">#20FF8F86</color>
    <color name="card_stroke">#12E9F1EC</color>       <!-- 7% light -->
    <color name="border_subtle">#12E9F1EC</color>     <!-- 7% light -->
    <color name="border_strong">#26E9F1EC</color>     <!-- 15% light -->

    <!-- Status indicators -->
    <color name="block_indicator">#FF8F86</color>
    <color name="allow_indicator">#5CF0AC</color>
    <color name="surface_gradient_start">#0B0F0D</color>
    <color name="surface_gradient_end">#161F1A</color>

    <!-- Badge backgrounds (~12-14% alpha) -->
    <color name="badge_success_bg">#1F5CF0AC</color>
    <color name="badge_error_bg">#1FFF8F86</color>
    <color name="badge_ai_bg">#24B79BFF</color>
    <color name="badge_info_bg">#1F7CC4FF</color>
    <color name="badge_warn_bg">#1FFFC94D</color>

    <!-- Skeleton shimmer -->
    <color name="skeleton_base">#1C2721</color>
    <color name="skeleton_hi">#232F29</color>
</resources>
