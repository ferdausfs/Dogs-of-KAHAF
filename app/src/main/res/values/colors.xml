<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ===== GUARDIAN SHIELD — "Neutral Pro" palette (v3, 2026-08-23) =====
         Design direction (user-approved): modern-neutral + clean-chunky.
         True neutral monochrome ladder (NO tint), ONE restrained accent
         (System Blue), iOS-pro semantics, opacity-based structure colors.
         Every legacy color NAME is preserved so R.color.* refs keep compiling;
         only the VALUES moved.

         Palette goals vs r2 ("One UI 8" Galaxy Blue):
           · Neutral surfaces (Apple-pro feel) instead of cool-tinted ladder
           · Single bright-but-restrained accent #0A84FF (reads premium on
             near-black, AA-safe for buttons)
           · Semantic status colors harmonized to the same family (iOS dark)
           · Text contrast re-verified >= AA for all text/surface pairs used. -->

    <!-- Surfaces — true neutral ladder (no hue tint). Levels =
         bg < elevated < inset/high < surface < variant/highest -->
    <color name="bg_main">#0A0A0B</color>
    <color name="bg_elevated">#121214</color>
    <color name="surface">#1C1C1F</color>
    <color name="surface_variant">#232326</color>
    <color name="surface_high">#232326</color>
    <color name="surface_highest">#2C2C2F</color>

    <!-- Accent — System Blue: solid fill for primary actions, brighter
         "link" stop for text-on-surface, dim containers for hero cards. -->
    <color name="primary">#0A84FF</color>
    <color name="on_primary">#FFFFFF</color>
    <color name="primary_container">#0D2440</color>
    <color name="primary_container_start">#113052</color>
    <color name="primary_container_end">#0A1C33</color>
    <color name="on_primary_container">#CFE6FF</color>
    <color name="primary_dim">#4EA7FF</color>
    <color name="beacon_dim">#330A84FF</color>

    <color name="secondary">#8E8E93</color>
    <color name="on_secondary">#0A0A0B</color>
    <color name="secondary_container">#2C2C2F</color>
    <color name="on_secondary_container">#F2F2F7</color>

    <!-- Semantic — iOS dark-mode family (status only) -->
    <color name="error">#FF453A</color>
    <color name="error_bright">#FF6B61</color>
    <color name="on_error">#FFFFFF</color>
    <color name="error_container">#3B1E20</color>
    <color name="on_error_container">#FFB8B3</color>
    <color name="success">#30D158</color>
    <color name="success_container">#153326</color>
    <color name="success_legacy">#63E6A2</color>
    <color name="warning_amber">#FFD60A</color>
    <color name="warning">#FF9F0A</color>
    <color name="warning_container">#3B2E14</color>
    <color name="on_warning_container">#FFE3B3</color>
    <color name="info_sky">#4EA7FF</color>
    <color name="info_container">#0D2440</color>

    <!-- Text -->
    <color name="on_surface">#F2F2F7</color>
    <color name="on_surface_variant">#98989E</color>
    <color name="on_surface_dim">#636368</color>
    <color name="inverse_surface">#F2F2F7</color>
    <color name="on_inverse">#0A0A0B</color>

    <!-- Structure -->
    <color name="black">#000000</color>
    <color name="white">#FFFFFF</color>
    <color name="transparent">#00000000</color>
    <color name="overlay_dim">#A6000000</color>
    <color name="overlay_dim_solid">#0A0A0B</color>
    <color name="ripple_primary">#334EA7FF</color>
