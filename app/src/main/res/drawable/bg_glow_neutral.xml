<?xml version="1.0" encoding="utf-8"?>
<!-- Neutral white radial glow for the dashboard hero shield pulse. White (not
     accent-violet) so the breathing aura reads correctly on EVERY hero state
     (violet ON / amber PAUSED / red OFF). Purely visual. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
    <gradient
        android:type="radial"
        android:gradientRadius="42dp"
        android:centerX="0.5"
        android:centerY="0.5"
        android:startColor="#40FFFFFF"
        android:centerColor="#1FFFFFFF"
        android:endColor="@android:color/transparent"/>
</shape>
