<?xml version="1.0" encoding="utf-8"?>
<!-- WATCHTOWER V3 launcher background — deep canvas + faint beacon rings -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ic_launcher_background"/>
        </shape>
    </item>
    <item android:gravity="center">
        <shape android:shape="oval">
            <stroke android:width="2dp" android:color="#1A7FE7C4"/>
            <size android:width="92dp" android:height="92dp"/>
        </shape>
    </item>
    <item android:gravity="center">
        <shape android:shape="oval">
            <stroke android:width="2dp" android:color="#14FFFFFF"/>
            <size android:width="120dp" android:height="120dp"/>
        </shape>
    </item>
</layer-list>
