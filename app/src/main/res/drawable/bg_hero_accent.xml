<?xml version="1.0" encoding="utf-8"?>
<!-- r2 depth: protection hero (ON). Deep accent container + top-edge light +
     soft same-hue glow border — the "floating" cue for the highest emphasis
     surface. Purely visual. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270"
                android:startColor="@color/primary_container_start"
                android:endColor="@color/primary_container_end"/>
            <corners android:radius="32dp"/>
            <stroke android:width="1dp" android:color="@color/glow_accent"/>
        </shape>
    </item>
    <item android:gravity="top" android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/edge_highlight"/>
            <corners android:radius="32dp"/>
        </shape>
    </item>
</layer-list>
